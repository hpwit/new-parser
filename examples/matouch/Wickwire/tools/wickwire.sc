void drawThings()
{
   for (int i = 0; i < eCount; i++)
   {
      int t = eType[i];
      if (t == E_NONE)
         continue;
      // only what is in front of the camera, and near
      ffloat ox = eX[i] - camX;
      ffloat oy = eY[i] - camY;
      ffloat oz = eZ[i] - camZ;
      ffloat z = ox * fX + oy * fY + oz * fZ;
      if (z < -2 || z > FAR)
         continue;
      ffloat x = ox * rX + oy * rY + oz * rZ;
      if (x > z * 2 + 3 || x < -z * 2 - 3)
         continue;
      if (t == E_GEAR)
         drawGear(i, eY[i]);
      else if (t == E_POPGEAR)
         drawGear(i, eY[i] - 0.4);
      else if (t == E_CRATE || t == E_CRATE_GEAR)
         drawCrate(i);
      else if (t == E_CANDLE)
         drawCandle(i);
      else if (t == E_GHOST)
         drawGhost(i);
      else if (t == E_BOMB)
         drawBomb(i);
      else if (t == E_KNIGHT)
         drawKnight(i);
      else if (t == E_BAT)
         drawBat(i);
      else if (t == E_SPIDER)
         drawSpider(i);
      else if (t == E_KEY)
         drawKey(i);
      else if (t == E_DOOR)
         drawDoor(i);
      else if (t == E_MOVER || t == E_FALLER)
         drawPlatform(i);
      else if (t == E_HEART)
         drawHeart(i);
      else if (t == E_EXIT)
         drawExit(i);
      else if (t == E_LAUNCH)
         drawLaunch(i);
      else if (t == E_CHANDELIER)
         drawChandelier(i);
      else if (t == E_ARMOUR)
         drawArmourDeco(i);
      else if (t == E_BOSS)
         drawBoss(i);
      else if (t == E_ORB)
         drawOrb(i);
   }
}

// ------------------------------------------------------------------ the screen's frame

int msFrame;
int showMs;
int msSky;
int msClear;
int msWorld;
int msThings;
int msLogic;
int lastTris;
int lastPixels;

void drawHud()
{
   dimRect(0, 0, SW, 14, col(6, 4, 14));
   // the candle's health: three flames
   for (int k = 0; k < 3; k++)
   {
      uint16_t c = col(60, 40, 50);
      uint16_t c2 = col(60, 40, 50);
      if (k < health)
      {
         c = col(255, 200, 60);
         c2 = col(255, 250, 220);
      }
      int x = 6 + k * 12;
      fillRect(x + 2, 4, 4, 7, c);
      fillRect(x + 3, 2, 2, 3, c2);
      fillRect(x + 1, 10, 6, 2, col(180, 140, 70));
   }
   // gears
   uint16_t gc = col(240, 190, 70);
   fillRect(48, 4, 7, 7, gc);
   fillRect(50, 2, 3, 11, gc);
   fillRect(46, 6, 11, 3, gc);
   fillRect(50, 6, 3, 3, col(60, 40, 20));
   setInk(col(255, 236, 160), col(20, 12, 24), 1);
   int x = drawNum(gears, 2, 60, 3);
   // lives
   setInk(col(255, 160, 90), col(20, 12, 24), 1);
   x = drawText("WICK x", x + 12, 3);
   x = drawNum(imax(0, lives), 1, x, 3);
   if (keys > 0)
   {
      setInk(col(255, 220, 80), col(20, 12, 24), 1);
      x = drawText("  KEY", x, 3);
   }
   if (showMs == 1)
   {
      // where the time goes: the whole picture, then sky, depth clear,
      // the level, the characters, the game's steps; triangles, pixels
      dimRect(0, 14, SW, 12, col(6, 4, 14));
      setInk(col(160, 255, 160), col(20, 12, 24), 1);
      int y2 = 16;
      int x2 = drawNum(msFrame, 1, 4, y2);
      x2 = drawText("ms  sky ", x2, y2);
      x2 = drawNum(msSky, 1, x2, y2);
      x2 = drawText(" z ", x2, y2);
      x2 = drawNum(msClear, 1, x2, y2);
      x2 = drawText(" lvl ", x2, y2);
      x2 = drawNum(msWorld, 1, x2, y2);
      x2 = drawText(" obj ", x2, y2);
      x2 = drawNum(msThings, 1, x2, y2);
      x2 = drawText(" step ", x2, y2);
      x2 = drawNum(msLogic, 1, x2, y2);
      x2 = drawText("  tri ", x2, y2);
      x2 = drawNum(lastTris, 1, x2, y2);
      x2 = drawText(" px ", x2, y2);
      drawNum(lastPixels / 1000, 1, x2, y2);
      drawText("k", x2 + 20, y2);
   }
   setInk(col(255, 255, 255), col(20, 12, 24), 1);
   char *sc = numText(score, 7);
   drawText(sc, SW - 4 - textWidth(sc), 3);
   if (showName > 0)
   {
      setInk(col(255, 230, 180), col(30, 10, 30), 2);
      centreText(levelName(levelNo), 40);
   }
   if (paused == 1)
   {
      dimRect(0, 0, SW, SH, col(0, 0, 0));
      setInk(col(255, 255, 255), col(0, 0, 0), 3);
      centreText("PAUSED", 90);
      setInk(col(200, 210, 240), col(0, 0, 0), 1);
      centreText("Enter: go on    Escape: leave", 130);
   }
}

void renderFrame()
{
   frameNo++;
   trisDrawn = 0;
   pixelsDrawn = 0;
   uint32_t t0 = millis();
   drawSky();
   uint32_t t1 = millis();
   uint32_t t2 = t1;
   drawWorld();
   uint32_t t3 = millis();
   drawShadow();
   drawThings();
   if (hDead == 0 || hDead < 40)
      drawWick();
   drawParticles();
   uint32_t t4 = millis();
   msSky = t1 - t0;
   msClear = t2 - t1;
   msWorld = t3 - t2;
   msThings = t4 - t3;
   lastTris = trisDrawn;
   lastPixels = pixelsDrawn;
   drawHud();
}

// ------------------------------------------------------------------ the screen's mode
//
// The game is always 400x240. Pixel size 2: it fills the 800x480 panel,
// each pixel 2x2. Pixel size 1: it runs in a window in the middle of the
// panel, a black frame round it. The title (full screen) has a menu for
// it; M switches in the game.

int pixelMode = 2;

// the whole 800x480 frame black, in both buffers
void blankPanel()
{
   uint16_t black = col(0, 0, 0);
   for (int k = 0; k < 2; k++)
   {
      for (int i = 0; i < 480 * stride; i++)
         display[i] = black;
      updateDisplay();
   }
}

void setMode(int mode)
{
   pixelMode = mode;
   setPixelsize(mode);
   if (mode == 1)
      orgOff = 120 * stride + 200;
   else
      orgOff = 0;
   blankPanel();
}

// ------------------------------------------------------------------ the keys

int getKey()
{
   int k = readKey();
   if (k == 10)
      k = 13;
   return k;
}

int held(int a, int b)
{
   if (keyHeld(a) == 1)
      return 1;
   if (b != 0 && keyHeld(b) == 1)
      return 1;
   return 0;
}

void readKeys()
{
   pressJump = 0;
   pressSpin = 0;
   menuKey = 0;
   int k = getKey();
   while (k != 0)
   {
      if (k == KEY_SPACE || k == KEY_K)
         pressJump = 1;
      else if (k == KEY_F || k == KEY_J)
         pressSpin = 1;
      else if (k == KEY_ENTER || k == KEY_ESC)
         menuKey = k;
      else if (k == KEY_P)
         showMs = 1 - showMs;
      else if (k == KEY_M)
         setMode(3 - pixelMode);
      k = getKey();
   }
   kUp = held(KEY_UP, KEY_W);
   kDown = held(KEY_DOWN, 0);
   kLeft = held(KEY_LEFT, KEY_A);
   kRight = held(KEY_RIGHT, 0);
   kJump = held(KEY_SPACE, KEY_K);
   kSpin = held(KEY_F, KEY_J);
}

int waitKey()
{
   while (true)
   {
      int k = getKey();
      if (k == KEY_ENTER || k == KEY_SPACE)
         return 1;
      if (k == KEY_ESC)
         return 0;
      delay(15);
   }
   return 0;
}

void clearScreen(uint16_t c)
{
   fillRect(0, 0, SW, SH, c);
}

// ------------------------------------------------------------------ screens

// the title: the courtyard, the camera slowly round the well
// the title, full screen: the courtyard, the camera slowly round the
// well, and a menu: play full screen, or in a window in the middle of the
// panel. Returns 0 when Escape leaves the game.
int menuChoice = 0;

int title()
{
   if (pixelMode != 2)
      setMode(2);
   loadLevel(0);
   spawnAll();
   uint32_t t0 = millis();
   while (true)
   {
      uint32_t now = millis();
      int a = ((now - t0) / 30) & 1023;
      ffloat cx = isin(a) * 9;
      ffloat cz = 34 + icos(a) * 9;
      hx = 0;
      hy = 0;
      hz = 34;
      hDead = 0;
      hHurt = 0;
      lookAt(cx, 4.5, cz, 0, 1.5, 34, 0, 1, 0);
      heroX = 0;
      heroY = -50;
      heroZ = 0;
      frameNo++;
      drawSky();
      drawWorld();
      drawThings();
      hyaw = (a + 512) & 1023;
      hGround = 1;
      hRun = (now - t0);
      hPlanet = -1;
      hSpin = 0;
      drawWick();
      dimRect(40, 22, 320, 62, col(10, 6, 20));
      setInk(col(255, 200, 90), col(60, 20, 10), 4);
      centreText("WICKWIRE", 28);
      setInk(col(240, 230, 255), col(20, 10, 30), 1);
      centreText("and the Haunted Keep", 68);
      // the menu: the two ways to show the game's 400x240
      dimRect(110, 140, 180, 48, col(10, 6, 20));
      for (int k = 0; k < 2; k++)
      {
         int y = 146 + k * 20;
         if (k == menuChoice)
         {
            fillRect(116, y - 3, 168, 15, col(255, 170, 60));
            setInk(col(30, 10, 10), col(255, 220, 150), 1);
         }
         else
            setInk(col(230, 230, 255), col(20, 10, 30), 1);
         if (k == 0)
            centreText("PLAY FULL SCREEN (2x)", y);
         else
            centreText("PLAY IN A WINDOW (1x)", y);
      }
      setInk(col(210, 220, 255), col(10, 5, 20), 1);
      centreText("up/down choose  Enter play  Esc leave", 206);
      setInk(col(170, 180, 220), col(10, 5, 20), 1);
      centreText("in the game: M switches", 220);
      updateDisplay();
      int k = getKey();
      if (k == KEY_UP || k == KEY_W || k == KEY_DOWN)
         menuChoice = 1 - menuChoice;
      if (k == KEY_ENTER || k == KEY_SPACE)
      {
         if (menuChoice == 1)
            setMode(1);
         return 1;
      }
      if (k == KEY_ESC)
         return 0;
   }
   return 1;
}

void story(int off)
{
   int page = off;
   while (page >= 0)
   {
      clearScreen(col(8, 6, 20));
      fillRect(30, 30, SW - 60, 1, col(140, 100, 50));
      fillRect(30, SH - 40, SW - 60, 1, col(140, 100, 50));
      setInk(col(250, 240, 220), col(30, 20, 40), 1);
      int next = drawStoryPage(page, 44, 56, SW - 88, 14);
      setInk(col(170, 160, 200), col(0, 0, 0), 1);
      centreText("Enter", SH - 28);
      updateDisplay();
      if (waitKey() == 0)
         return;
      page = next;
   }
}

void levelCard()
{
   clearScreen(col(6, 4, 14));
   setInk(col(255, 200, 90), col(40, 16, 10), 2);
   int x = (SW - textWidth("LEVEL 1")) / 2;
   x = drawText("LEVEL ", x, 70);
   drawNum(levelNo + 1, 1, x, 70);
   setInk(col(240, 240, 255), col(20, 10, 40), 2);
   centreText(levelName(levelNo), 100);
   setInk(col(255, 255, 255), col(0, 0, 0), 2);
   x = drawText("WICK x ", 150, 150);
   drawNum(lives, 1, x, 150);
   updateDisplay();
   delay(1600);
}

void gameOver()
{
   clearScreen(col(4, 2, 10));
   setInk(col(220, 140, 90), col(40, 10, 0), 3);
   centreText("THE CANDLE", 70);
   centreText("GOES OUT", 100);
   setInk(col(220, 220, 240), col(0, 0, 0), 1);
   int x = drawText("score ", 150, 150);
   drawNum(score, 7, x, 150);
   centreText("Enter", 190);
   updateDisplay();
   waitKey();
}

void ending()
{
   story(STORY_END);
   clearScreen(col(6, 6, 20));
   setInk(col(255, 200, 90), col(40, 16, 10), 3);
   centreText("WICKWIRE", 60);
   setInk(col(240, 240, 255), col(0, 0, 0), 1);
   int x = drawText("final score ", 130, 120);
   drawNum(score, 7, x, 120);
   centreText("made with ESPLiveScript on the ESP32-S3", 170);
   updateDisplay();
   waitKey();
}

// ------------------------------------------------------------------ a level

void respawn()
{
   hx = checkX;
   hy = checkY + 0.05;
   hz = checkZ;
   hvx = 0;
   hvy = 0;
   hvz = 0;
   hyaw = 0;
   hGround = 0;
   hDead = 0;
   hHurt = 50;
   hSpin = 0;
   hFly = 0;
   hPlanet = -1;
   hOnMover = -1;
   gux = 0;
   guy = 1;
   guz = 0;
   health = 3;
   int zi = zoneAt(hx, hy, hz);
   if (zi >= 0)
      hyaw = (zyaw[zi] * 1024 / 360) & 1023;
   updateCamera(1);
}

// plays level n: 1 done, 0 out of lives, -1 left
int playLevel(int n)
{
   loadLevel(n);
   spawnAll();
   levelCard();
   levelDone = 0;
   paused = 0;
   showName = 80;
   keys = 0;
   respawn();
   hHurt = 0;
   uint32_t last = millis();
   int doneSteps = 0;
   while (true)
   {
      readKeys();
      if (menuKey == KEY_ENTER)
         paused = 1 - paused;
      if (menuKey == KEY_ESC)
      {
         paused = 1;
         renderFrame();
         dimRect(60, 84, 280, 56, col(0, 0, 0));
         setInk(col(255, 255, 255), col(0, 0, 0), 1);
         centreText("Leave this run? Y / N", 106);
         updateDisplay();
         while (true)
         {
            int k = getKey();
            if (k == KEY_Y)
               return -1;
            if (k == KEY_N || k == KEY_ESC || k == KEY_ENTER)
               break;
            delay(15);
         }
         paused = 0;
         last = millis();
      }
      uint32_t now = millis();
      if (paused == 1)
      {
         renderFrame();
         updateDisplay();
         delay(30);
         last = now;
         continue;
      }
      int steps = (now - last) / 33;
      if (steps < 1)
      {
         delay(33 - (now - last));
         continue;
      }
      if (steps > 3)
      {
         steps = 3;
         last = now;
      }
      else
         last = last + steps * 33;
      uint32_t tl = millis();
      for (int s = 0; s < steps; s++)
      {
         updateHero();
         updateThings();
         updateParticles();
         if (showName > 0)
            showName--;
         pressJump = 0;
         pressSpin = 0;
         if (levelDone > 0)
            doneSteps++;
      }
      msLogic = millis() - tl;
      updateCamera(0);
      uint32_t t1 = millis();
      renderFrame();
      updateDisplay();
      msFrame = millis() - t1;
      if (hDead > 50)
      {
         lives--;
         if (lives < 0)
            return 0;
         levelCard();
         respawn();
         last = millis();
      }
      if (levelDone > 0 && doneSteps > 50)
      {
         score = score + 1000;
         return 1;
      }
   }
   return -1;
}

// ------------------------------------------------------------------ starting

void newGame()
{
   score = 0;
   lives = 4;
   gears = 0;
   health = 3;
}

int main()
{
   if (wadLoaded == 0)
   {
      printfln("wickwire.wad must be next to the script");
      return 1;
   }
   enableGraphicMode();
   // the title is full screen; the command line's 1 chooses the window in
   // its menu beforehand
   setMode(2);
   if (argc > 0 && arg(0) == 1)
      menuChoice = 1;
   fontOff = wadFind("FONT");
   textOff = wadFind("TEXT");
   clearScreen(col(0, 0, 0));
   setInk(col(255, 200, 90), col(0, 0, 0), 1);
   centreText("winding up...", 116);
   updateDisplay();
   makeSines();
   loadPalette();
   loadTextures();
   makeStars();
   while (true)
   {
      if (title() == 0)
         return 0;
      story(STORY_INTRO);
      newGame();
      int n = startLevel;
      startLevel = 0;
      while (n < NLEVELS)
      {
         int r = playLevel(n);
         if (r == 1)
            n++;
         else
         {
            if (r == 0)
               gameOver();
            break;
         }
      }
      if (n >= NLEVELS)
         ending();
   }
   return 0;
}
