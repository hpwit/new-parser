// ------------------------------------------------------------------ small helpers

int iabs(int v)
{
   if (v < 0)
      return -v;
   return v;
}

int imin(int a, int b)
{
   if (a < b)
      return a;
   return b;
}

int imax(int a, int b)
{
   if (a > b)
      return a;
   return b;
}

int clampi(int v, int lo, int hi)
{
   if (v < lo)
      return lo;
   if (v > hi)
      return hi;
   return v;
}

ffloat fabsx(ffloat v)
{
   if (v < 0)
      return -v;
   return v;
}

ffloat fminx(ffloat a, ffloat b)
{
   if (a < b)
      return a;
   return b;
}

ffloat fmaxx(ffloat a, ffloat b)
{
   if (a > b)
      return a;
   return b;
}

ffloat fclamp(ffloat v, ffloat lo, ffloat hi)
{
   if (v < lo)
      return lo;
   if (v > hi)
      return hi;
   return v;
}

int rnd(int n)
{
   if (n <= 1)
      return 0;
   return rand(n);
}

// RGB565 with its two bytes swapped, as the panel wants it
uint16_t col(int r, int g, int b)
{
   r = clampi(r, 0, 255);
   g = clampi(g, 0, 255);
   b = clampi(b, 0, 255);
   int v = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
   return ((v & 255) << 8) | (v >> 8);
}

// ------------------------------------------------------------------ angles
//
// An angle is an int, 1024 a full turn. isin()/icos() give ffloat sines
// from a table made at the start with the bound sin().

ffloat sinT[1024];

void makeSines()
{
   for (int i = 0; i < 1024; i++)
   {
      float a = i * 0.00613592315;
      float s = sin(a);
      sinT[i] = s;
   }
}

ffloat isin(int a)
{
   return sinT[a & 1023];
}

ffloat icos(int a)
{
   return sinT[(a + 256) & 1023];
}

// the angle of (x, z), 0 along +z, 256 along +x
int iangle(ffloat x, ffloat z)
{
   float fx = x;
   float fz = z;
   float a = atan2(fx, fz);
   int r = (int)(a * 162.974661);
   return r & 1023;
}

// the length of (x, y, z)
ffloat len3(ffloat x, ffloat y, ffloat z)
{
   float fx = x;
   float fy = y;
   float fz = z;
   float h = hypot(fx, fy);
   float l = hypot(h, fz);
   ffloat r = l;
   return r;
}

ffloat len2(ffloat x, ffloat z)
{
   float fx = x;
   float fz = z;
   float l = hypot(fx, fz);
   ffloat r = l;
   return r;
}

// the shortest way from angle a to angle b (-512..511)
int angleDiff(int a, int b)
{
   int d = (b - a) & 1023;
   if (d >= 512)
      d = d - 1024;
   return d;
}

// ------------------------------------------------------------------ the WAD

int rd16(int o)
{
   int v = ubuf[o] | (ubuf[o + 1] << 8);
   if (v >= 32768)
      v = v - 65536;
   return v;
}

int rdu16(int o)
{
   return ubuf[o] | (ubuf[o + 1] << 8);
}

int rd8s(int o)
{
   int v = ubuf[o];
   if (v >= 128)
      v = v - 256;
   return v;
}

// a position: int16 in 64ths of a unit
ffloat rdpos(int o)
{
   int v = rd16(o);
   ffloat f = v;
   return f / 64;
}

// unpacks a compressed lump into ubuf; returns its size
int unpack(char *name)
{
   int off = wadFind(name);
   if (off < 0)
      return 0;
   int n = wad[off] | (wad[off + 1] << 8) | (wad[off + 2] << 16) | (wad[off + 3] << 24);
   int i = off + 4;
   int o = 0;
   while (o < n)
   {
      int t = wad[i];
      i++;
      if (t < 128)
      {
         int cnt = t + 1;
         for (int k = 0; k < cnt; k++)
            ubuf[o + k] = wad[i + k];
         i = i + cnt;
         o = o + cnt;
      }
      else
      {
         int ln = (t & 127) + 3;
         int d = wad[i] | (wad[i + 1] << 8);
         i = i + 2;
         for (int k = 0; k < ln; k++)
            ubuf[o + k] = ubuf[o + k - d];
         o = o + ln;
      }
   }
   return n;
}

void loadPalette()
{
   int p = wadFind("PAL");
   for (int i = 0; i < 256; i++)
   {
      palR[i] = wad[p + i * 3];
      palG[i] = wad[p + i * 3 + 1];
      palB[i] = wad[p + i * 3 + 2];
   }
}

void loadTextures()
{
   int n = unpack("TEX");
   for (int i = 0; i < n && i < 40960; i++)
      texPix[i] = ubuf[i];
}

// every palette colour at 16 light levels (12 is the colour itself, 15 a
// little brighter) and 8 fog levels (7: the fog's colour). The light
// rises fast from dark (2l / (l + 12)): shadows stay coloured, not murky.
void makeShades()
{
   for (int f = 0; f < 8; f++)
   {
      int fogK = f * 256 / 9;
      for (int l = 0; l < 16; l++)
      {
         int lightK = (2 * l * 256) / (l + 12);
         int base = (f * 16 + l) * 256;
         for (int c = 0; c < 256; c++)
         {
            int r = (palR[c] * lightK) >> 8;
            int g = (palG[c] * lightK) >> 8;
            int b = (palB[c] * lightK) >> 8;
            r = r + (((fogR - r) * fogK) >> 8);
            g = g + (((fogG - g) * fogK) >> 8);
            b = b + (((fogB - b) * fogK) >> 8);
            shade[base + c] = col(r, g, b);
         }
      }
   }
}

// the sky: a colour a row, from the top colour down to the bottom one
void makeSky()
{
   for (int y = 0; y < SH; y++)
   {
      int k = y * 256 / SH;
      int r = skyTopR + (((skyBotR - skyTopR) * k) >> 8);
      int g = skyTopG + (((skyBotG - skyTopG) * k) >> 8);
      int b = skyTopB + (((skyBotB - skyTopB) * k) >> 8);
      skyRow[y] = col(r, g, b);
   }
}

// ------------------------------------------------------------------ text

uint16_t inkCol;
uint16_t shadowCol;
int textScale;

void setInk(uint16_t ink, uint16_t shadow, int scale)
{
   inkCol = ink;
   shadowCol = shadow;
   textScale = scale;
}

int glyphW(int c)
{
   if (c < 32 || c > 126)
      return 0;
   return wad[fontOff + c - 32] * textScale;
}

int textWidth(char *s)
{
   int w = 0;
   int i = 0;
   while (s[i] != 0)
   {
      int c = s[i];
      w = w + glyphW(c);
      i++;
   }
   return w;
}

void plotGlyph(int c, int x, int y, uint16_t ink)
{
   int g = fontOff + 95 + (c - 32) * 8;
   int sc = textScale;
   for (int r = 0; r < 8; r++)
   {
      int bits = wad[g + r];
      if (bits == 0)
         continue;
      for (int i = 0; i < 8; i++)
      {
         if (((bits << i) & 128) == 0)
            continue;
         for (int sy2 = 0; sy2 < sc; sy2++)
         {
            int yy = y + r * sc + sy2;
            if (yy < 0 || yy >= SH)
               continue;
            int o = orgOff + yy * stride;
            for (int sx2 = 0; sx2 < sc; sx2++)
            {
               int xx = x + i * sc + sx2;
               if (xx >= 0 && xx < SW)
                  display[o + xx] = ink;
            }
         }
      }
   }
}

int drawChar(int c, int x, int y)
{
   if (c < 32 || c > 126)
      return x;
   plotGlyph(c, x + textScale, y + textScale, shadowCol);
   plotGlyph(c, x, y, inkCol);
   return x + glyphW(c);
}

int drawText(char *s, int x, int y)
{
   int i = 0;
   while (s[i] != 0)
   {
      int c = s[i];
      x = drawChar(c, x, y);
      i++;
   }
   return x;
}

void centreText(char *s, int y)
{
   drawText(s, (SW - textWidth(s)) / 2, y);
}

char numBuf[16];
char numTmp[16];

char *numText(int v, int digits)
{
   int neg = 0;
   if (v < 0)
   {
      neg = 1;
      v = -v;
   }
   int n = 0;
   while (v > 0 || n < digits || n == 0)
   {
      numTmp[n] = 48 + v % 10;
      v = v / 10;
      n++;
      if (n >= 11)
         break;
   }
   int i = 0;
   if (neg == 1)
   {
      numBuf[0] = 45;
      i = 1;
   }
   for (int k = n - 1; k >= 0; k--)
   {
      numBuf[i] = numTmp[k];
      i++;
   }
   numBuf[i] = 0;
   return numBuf;
}

int drawNum(int v, int digits, int x, int y)
{
   return drawText(numText(v, digits), x, y);
}

// the story's pages, read from the WAD: a page ends at '|' or at the end
int drawStoryPage(int off, int x, int y, int maxw, int lineH)
{
   int cx = x;
   int cy = y;
   int i = off;
   while (true)
   {
      int c = wad[textOff + i];
      if (c == 0)
         return -1;
      if (c == 124)
         return i + 1;
      if (c == 32)
      {
         int w = glyphW(32);
         int k = i + 1;
         int c2 = wad[textOff + k];
         while (c2 != 0 && c2 != 32 && c2 != 124)
         {
            w = w + glyphW(c2);
            k++;
            c2 = wad[textOff + k];
         }
         if (cx + w > x + maxw)
         {
            cx = x;
            cy = cy + lineH;
         }
         else
            cx = drawChar(32, cx, cy);
         i++;
         continue;
      }
      cx = drawChar(c, cx, cy);
      i++;
   }
   return -1;
}

void fillRect(int x, int y, int w, int h, uint16_t c)
{
   int x0 = imax(0, x);
   int y0 = imax(0, y);
   int x1 = imin(SW, x + w);
   int y1 = imin(SH, y + h);
   for (int yy = y0; yy < y1; yy++)
   {
      int o = orgOff + yy * stride;
      for (int xx = x0; xx < x1; xx++)
         display[o + xx] = c;
   }
}

// darkens a rectangle: every other pixel
void dimRect(int x, int y, int w, int h, uint16_t c)
{
   int x0 = imax(0, x);
   int y0 = imax(0, y);
   int x1 = imin(SW, x + w);
   int y1 = imin(SH, y + h);
   for (int yy = y0; yy < y1; yy++)
   {
      int o = orgOff + yy * stride;
      for (int xx = x0 + ((x0 + yy) & 1); xx < x1; xx = xx + 2)
         display[o + xx] = c;
   }
}

// ------------------------------------------------------------------ the camera
//
// Its place, and three unit vectors: right, up and forward. A point p
// seen from it: x = (p - cam).right, y = (p - cam).up, z = (p - cam).fwd.

ffloat camX;
ffloat camY;
ffloat camZ;
ffloat rX;
ffloat rY;
ffloat rZ;
ffloat uX;
ffloat uY;
ffloat uZ;
ffloat fX;
ffloat fY;
ffloat fZ;
int camYaw;

// points the camera from (ex, ey, ez) at (tx, ty, tz), with `upx..` the
// world's up there (0, 1, 0), or a moonlet's
void lookAt(ffloat ex, ffloat ey, ffloat ez, ffloat tx, ffloat ty, ffloat tz, ffloat upx, ffloat upy, ffloat upz)
{
   camX = ex;
   camY = ey;
   camZ = ez;
   ffloat dx = tx - ex;
   ffloat dy = ty - ey;
   ffloat dz = tz - ez;
   ffloat l = len3(dx, dy, dz);
   if (l < 0.001)
      l = 0.001;
   fX = dx / l;
   fY = dy / l;
   fZ = dz / l;
   // right = up x forward
   ffloat ax = upy * fZ - upz * fY;
   ffloat ay = upz * fX - upx * fZ;
   ffloat az = upx * fY - upy * fX;
   l = len3(ax, ay, az);
   if (l < 0.001)
   {
      ax = 1;
      ay = 0;
      az = 0;
      l = 1;
   }
   rX = ax / l;
   rY = ay / l;
   rZ = az / l;
   // up = forward x right
   uX = fY * rZ - fZ * rY;
   uY = fZ * rX - fX * rZ;
   uZ = fX * rY - fY * rX;
   camYaw = iangle(fX, fZ);
}

// ------------------------------------------------------------------ the rasterizer
//
// A polygon is up to 8 corners in view space (vx, vy, vz) with texture
// coordinates (vu, vv in texels). It is clipped against the near plane,
// projected, and drawn as a fan of triangles. A triangle is drawn row by
// row: its texture coordinates and 1/z are interpolated across the screen
// (affine: the tools keep polygons small), 1/z tested against the depth
// buffer.

float vx[8];
float vy[8];
float vz[8];
float vu[8];
float vv[8];
float cx2[8];
float cy2[8];
float cz2[8];
float cu2[8];
float cv2[8];
float px[8];
float py[8];
float pw[8];
float pu[8];
float pv[8];

// what the current polygon is: a texture (texBase >= 0) or a flat colour,
// its shade row (fog and light), and see-through (ghosts)
int texBase;
int flatCol;
int shadeBase;
int ghostly;
int trisDrawn;
int pixelsDrawn;

float fclampf(float v, float lo, float hi)
{
   if (v < lo)
      return lo;
   if (v > hi)
      return hi;
   return v;
}

void drawTri(int a, int b, int c)
{
   float x0 = px[a];
   float y0 = py[a];
   float x1 = px[b];
   float y1 = py[b];
   float x2 = px[c];
   float y2 = py[c];
   float area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
   if (area > -0.5 && area < 0.5)
      return;
   float inv = 1.0 / area;
   // the gradients of u, v and w across the screen
   float du1 = pu[b] - pu[a];
   float du2 = pu[c] - pu[a];
   float dv1 = pv[b] - pv[a];
   float dv2 = pv[c] - pv[a];
   float dw1 = pw[b] - pw[a];
   float dw2 = pw[c] - pw[a];
   float dudx = (du1 * (y2 - y0) - du2 * (y1 - y0)) * inv;
   float dudy = (du2 * (x1 - x0) - du1 * (x2 - x0)) * inv;
   float dvdx = (dv1 * (y2 - y0) - dv2 * (y1 - y0)) * inv;
   float dvdy = (dv2 * (x1 - x0) - dv1 * (x2 - x0)) * inv;
   float dwdx = (dw1 * (y2 - y0) - dw2 * (y1 - y0)) * inv;
   float dwdy = (dw2 * (x1 - x0) - dw1 * (x2 - x0)) * inv;
   // u, v and w as planes over the screen, in integers: the value at
   // (x, y) is C + DX * x + DY * y (u and v in 4096ths of a texel, w in
   // 2^-20); each row starts from them, no float per row
   float cu = pu[a] - dudx * x0 - dudy * y0;
   float cv = pv[a] - dvdx * x0 - dvdy * y0;
   float cw = pw[a] - dwdx * x0 - dwdy * y0;
   int CU = (int)(cu * 4096.0);
   int CV = (int)(cv * 4096.0);
   int CW = (int)(cw * 1048576.0);
   int DUY = (int)(dudy * 4096.0);
   int DVY = (int)(dvdy * 4096.0);
   int DUX = (int)(dudx * 4096.0);
   int DVX = (int)(dvdx * 4096.0);
   int DWY = (int)(dwdy * 1048576.0);
   // top, middle, bottom
   int t = a;
   int m = b;
   int btm = c;
   if (py[m] < py[t])
   {
      int s = t;
      t = m;
      m = s;
   }
   if (py[btm] < py[t])
   {
      int s = t;
      t = btm;
      btm = s;
   }
   if (py[btm] < py[m])
   {
      int s = m;
      m = btm;
      btm = s;
   }
   float yt = py[t];
   float ym = py[m];
   float yb = py[btm];
   if (yb - yt < 0.01)
      return;
   float xt = px[t];
   float xm = px[m];
   float xb = px[btm];
   int ys = (int)(yt + 0.9999);
   int ye = (int)(yb + 0.9999);
   int yMid = (int)(ym + 0.9999);
   if (yt < 0)
      ys = 0;
   if (ye > SH)
      ye = SH;
   if (ys >= ye)
      return;
   // the edges in 16.16, stepped a row at a time (slopes kept in range)
   float sLong = (xb - xt) / (yb - yt);
   sLong = fclampf(sLong, -8000.0, 8000.0);
   float sTop = 0;
   if (ym - yt > 0.001)
      sTop = fclampf((xm - xt) / (ym - yt), -8000.0, 8000.0);
   float sBot = 0;
   if (yb - ym > 0.001)
      sBot = fclampf((xb - xm) / (yb - ym), -8000.0, 8000.0);
   float fys = ys;
   int xA = (int)((xt + (fys - yt) * sLong) * 65536.0);
   int dA = (int)(sLong * 65536.0);
   int xB;
   int dB;
   if (ys < yMid)
   {
      xB = (int)((xt + (fys - yt) * sTop) * 65536.0);
      dB = (int)(sTop * 65536.0);
   }
   else
   {
      xB = (int)((xm + (fys - ym) * sBot) * 65536.0);
      dB = (int)(sBot * 65536.0);
   }
   float ru = 0.5;
   if (dudx < 0)
      ru = -0.5;
   float rv = 0.5;
   if (dvdx < 0)
      rv = -0.5;
   int du = (int)(dudx * 64.0 + ru);
   int dv = (int)(dvdx * 64.0 + rv);
   int dw = (int)(dwdx * 1048576.0);
   int tb = texBase;
   int sb = shadeBase;
   uint16_t flat = shade[sb + flatCol];
   int duv = (dv << 16) + (du & 65535);
   trisDrawn++;
   for (int y = ys; y < ye; y++)
   {
      if (y == yMid)
      {
         float fy2 = y;
         xB = (int)((xm + (fy2 - ym) * sBot) * 65536.0);
         dB = (int)(sBot * 65536.0);
      }
      int lo = xA;
      int hi = xB;
      if (hi < lo)
      {
         lo = xB;
         hi = xA;
      }
      xA = xA + dA;
      xB = xB + dB;
      int xs = (lo + 65535) >> 16;
      int xe = (hi + 65535) >> 16;
      if (xs < 0)
         xs = 0;
      if (xe > SW)
         xe = SW;
      if (xs >= xe)
         continue;
      int w = CW + DWY * y + dw * xs;
      // one index across the depth buffer; the frame's is `i + dOff`
      int i = y * SW + xs;
      int iEnd = y * SW + xe;
      int dOff = orgOff + y * stride - y * SW;
      pixelsDrawn = pixelsDrawn + xe - xs;
      if (tb >= 0)
      {
         // u and v packed in one int, 10.6 fixed point each, v on top:
         // a carry between them is a 64th of a texel, never seen
         int u = (CU + DUY * y + DUX * xs) >> 6;
         int v = (CV + DVY * y + DVX * xs) >> 6;
         int uv = (v << 16) + (u & 65535);
         if (ghostly == 0)
         {
            while (i < iEnd)
            {
               if ((w >> 7) > zb[i])
               {
                  zb[i] = w >> 7;
                  display[i + dOff] = shade[sb + texPix[tb + ((uv >> 17) & 992) + ((uv >> 6) & 31)]];
               }
               uv = uv + duv;
               w = w + dw;
               i++;
            }
         }
         else
         {
            int par = (i + y + frameNo) & 1;
            while (i < iEnd)
            {
               if (par == 0 && (w >> 7) > zb[i])
                  display[i + dOff] = shade[sb + texPix[tb + ((uv >> 17) & 992) + ((uv >> 6) & 31)]];
               par = 1 - par;
               uv = uv + duv;
               w = w + dw;
               i++;
            }
         }
      }
      else
      {
         if (ghostly == 0)
         {
            while (i < iEnd)
            {
               if ((w >> 7) > zb[i])
               {
                  zb[i] = w >> 7;
                  display[i + dOff] = flat;
               }
               w = w + dw;
               i++;
            }
         }
         else
         {
            int par = (i + y + frameNo) & 1;
            while (i < iEnd)
            {
               if (par == 0 && (w >> 7) > zb[i])
                  display[i + dOff] = flat;
               par = 1 - par;
               w = w + dw;
               i++;
            }
         }
      }
   }
}

// clips the polygon vx..vv (n corners) at the near plane, projects it and
// draws it; returns 0 when nothing was left
int drawPoly(int n)
{
   // clip: keep z >= NEAR
   int m = 0;
   for (int i = 0; i < n; i++)
   {
      int j = i + 1;
      if (j == n)
         j = 0;
      float za = vz[i];
      float zb2 = vz[j];
      if (za >= NEAR)
      {
         cx2[m] = vx[i];
         cy2[m] = vy[i];
         cz2[m] = za;
         cu2[m] = vu[i];
         cv2[m] = vv[i];
         m++;
      }
      int ina = 0;
      int inb = 0;
      if (za >= NEAR)
         ina = 1;
      if (zb2 >= NEAR)
         inb = 1;
      if (ina != inb)
      {
         float t = (NEAR - za) / (zb2 - za);
         cx2[m] = vx[i] + (vx[j] - vx[i]) * t;
         cy2[m] = vy[i] + (vy[j] - vy[i]) * t;
         cz2[m] = NEAR;
         cu2[m] = vu[i] + (vu[j] - vu[i]) * t;
         cv2[m] = vv[i] + (vv[j] - vv[i]) * t;
         m++;
      }
      if (m >= 8)
         break;
   }
   if (m < 3)
      return 0;
   // project; a polygon wholly off one side of the screen is skipped
   int left = 0;
   int right = 0;
   int above = 0;
   int below = 0;
   for (int i = 0; i < m; i++)
   {
      float iz = 1.0 / cz2[i];
      px[i] = HALFW + cx2[i] * FOCAL * iz;
      py[i] = HALFH - cy2[i] * FOCAL * iz;
      pw[i] = iz;
      pu[i] = cu2[i];
      pv[i] = cv2[i];
      if (px[i] < 0)
         left++;
      if (px[i] > SW)
         right++;
      if (py[i] < 0)
         above++;
      if (py[i] > SH)
         below++;
   }
   if (left == m || right == m || above == m || below == m)
      return 0;
   for (int i = 1; i + 1 < m; i++)
      drawTri(0, i, i + 1);
   return 1;
}

// the shade row for a light level and a distance
int shadeFor(int light, ffloat z)
{
   int fog = 0;
   if (z > fogNear)
   {
      ffloat k = (z - fogNear) * 8 / (fogFar - fogNear);
      fog = (int)(k);
      if (fog > 7)
         fog = 7;
   }
   if (light > 15)
      light = 15;
   if (light < 0)
      light = 0;
   return (fog * 16 + light) * 256;
}

// ------------------------------------------------------------------ the distance
//
// Painted into the sky before the level, so it costs no polygon: a ring of
// far mountains in the haze, nearer hills with the towers of other castles
// and their lit windows, drifting clouds, birds. Each is a direction on a
// sky dome round the camera: only its turning moves them, never its place.

ffloat farHill[256];    // the far range: its height (a slope) per 1/256 turn
ffloat nearHill[256];   // the near hills
uint8_t towerAt[256];   // a tower on the near hills: its height in pixels-ish
uint16_t farCol;
uint16_t nearCol;
uint16_t nearDark;
uint16_t cloudLit;
uint16_t cloudMid;
uint16_t cloudDark;
uint16_t windowCol;
uint16_t birdCol;
ffloat cloudA[12];
ffloat cloudE[12];
ffloat cloudS[12];
ffloat birdA[8];
ffloat birdE[8];
int birdPh[8];

int mixc(int a, int b, int k)
{
   return a + (((b - a) * k) >> 8);
}

void makeScenery()
{
   // heights from a few waves that close up round the turn
   int p1 = rnd(1024);
   int p2 = rnd(1024);
   int p3 = rnd(1024);
   for (int i = 0; i < 256; i++)
   {
      int a = i * 4;
      ffloat h = isin(a * 3 + p1) * 0.05 + isin(a * 7 + p2) * 0.03 + isin(a * 13 + p3) * 0.015;
      farHill[i] = 0.1 + h;
      ffloat n = isin(a * 5 + p2) * 0.03 + isin(a * 11 + p1) * 0.018 + isin(a * 23 + p3) * 0.008;
      nearHill[i] = 0.045 + n;
      towerAt[i] = 0;
   }
   // a few towers, two or three columns wide
   for (int t = 0; t < 7; t++)
   {
      int at = rnd(250);
      int h = 14 + rnd(22);
      for (int k = 0; k < 3; k++)
         towerAt[at + k] = h;
   }
   farCol = col(mixc(skyBotR, fogR, 90) * 3 / 4, mixc(skyBotG, fogG, 90) * 3 / 4, mixc(skyBotB, fogB, 90) * 4 / 5);
   nearCol = col(fogR * 2 / 5, fogG * 2 / 5 + 10, fogB * 2 / 5);
   nearDark = col(fogR / 4, fogG / 4 + 6, fogB / 4);
   cloudLit = col(255, 250, 245);
   cloudMid = col(mixc(255, skyBotR, 90), mixc(250, skyBotG, 90), mixc(255, skyBotB, 70));
   cloudDark = col(mixc(220, skyTopR, 120), mixc(220, skyTopG, 120), mixc(240, skyTopB, 100));
   windowCol = col(255, 220, 110);
   birdCol = col(skyTopR / 3, skyTopG / 3, skyTopB / 3);
   for (int c = 0; c < 12; c++)
   {
      cloudA[c] = rnd(1024);
      cloudE[c] = 0.12 + rnd(100) * 0.004;
      if (scenery == 2)
         cloudE[c] = -0.08 - rnd(100) * 0.004;
      cloudS[c] = 0.6 + rnd(100) * 0.008;
   }
   for (int b = 0; b < 8; b++)
   {
      birdA[b] = rnd(1024);
      birdE[b] = 0.2 + rnd(100) * 0.003;
      birdPh[b] = rnd(1024);
   }
}

// a direction on the dome (angle a round, slope e up) on the screen;
// 0 when behind the camera
int domeX;
int domeY;

int domePoint(ffloat a, ffloat e)
{
   int ai = (int)(a);
   ffloat dx = isin(ai);
   ffloat dz = icos(ai);
   ffloat z = dx * fX + e * fY + dz * fZ;
   if (z < 0.15)
      return 0;
   ffloat x = dx * rX + e * rY + dz * rZ;
   ffloat y = dx * uX + e * uY + dz * uZ;
   domeX = HALFW + (int)(x * 230 / z);
   domeY = HALFH - (int)(y * 230 / z);
   return 1;
}

// the screen row of slope e in the direction of screen column x
int rowOfSlope(int x, ffloat e)
{
   // the column's way, flat: forward plus right times its offset
   ffloat k = x - HALFW;
   k = k / 230;
   ffloat dx = fX + rX * k;
   ffloat dz = fZ + rZ * k;
   ffloat l = len2(dx, dz);
   if (l < 0.001)
      return SH;
   dx = dx / l;
   dz = dz / l;
   ffloat z = dx * fX + e * fY + dz * fZ;
   if (z < 0.05)
      return SH;
   ffloat y = dx * uX + e * uY + dz * uZ;
   return HALFH - (int)(y * 230 / z);
}

// the mountains, the hills, their towers: columns of colour down from
// their crest to the bottom of the screen (the level covers what is near)
void drawRanges()
{
   int step = 2;
   for (int x = 0; x < SW; x = x + step)
   {
      ffloat k = x - HALFW;
      k = k / 230;
      ffloat dx = fX + rX * k;
      ffloat dz = fZ + rZ * k;
      int ang = iangle(dx, dz);
      int idx = (ang >> 2) & 255;
      int yFar = rowOfSlope(x, farHill[idx]);
      int yNear = rowOfSlope(x, nearHill[idx]);
      int yGround = rowOfSlope(x, 0);
      int tower = towerAt[idx];
      if (yFar < 0)
         yFar = 0;
      for (int y = yFar; y < SH && y < yNear; y++)
      {
         int o = orgOff + y * stride + x;
         display[o] = farCol;
         display[o + 1] = farCol;
      }
      int yTop = yNear;
      if (tower > 0 && scenery == 1)
         yTop = yNear - tower;
      if (yTop < 0)
         yTop = 0;
      for (int y = yTop; y < SH && y < yGround + 40; y++)
      {
         uint16_t c = nearCol;
         if (y >= yNear + 6)
            c = nearDark;
         if (tower > 0 && y < yNear && ((y - yTop) % 7) == 3 && ((idx + x) & 2) != 0)
            c = windowCol;
         int o = orgOff + y * stride + x;
         display[o] = c;
         display[o + 1] = c;
      }
   }
}

// a filled ellipse on the screen, one colour
void blob(int cx, int cy, int rx, int ry, uint16_t c)
{
   if (rx < 1 || ry < 1)
      return;
   for (int dy = -ry; dy <= ry; dy++)
   {
      int y = cy + dy;
      if (y < 0 || y >= SH)
         continue;
      int w = rx * (ry * ry - dy * dy);
      int half = 0;
      // the half width: rx * sqrt(1 - (dy/ry)^2), by a short search
      while (half < rx && (half + 1) * (half + 1) * ry * ry <= rx * rx * (ry * ry - dy * dy))
         half++;
      w = half;
      int x0 = imax(0, cx - w);
      int x1 = imin(SW - 1, cx + w);
      int o = orgOff + y * stride;
      for (int x = x0; x <= x1; x++)
         display[o + x] = c;
   }
}

// clouds: puffs, lit on top, darker under; they drift round slowly
void drawClouds()
{
   for (int c = 0; c < 12; c++)
   {
      cloudA[c] = cloudA[c] + 0.08;
      if (cloudA[c] >= 1024)
         cloudA[c] = cloudA[c] - 1024;
      if (domePoint(cloudA[c], cloudE[c]) == 0)
         continue;
      int cx = domeX;
      int cy = domeY;
      if (cx < -80 || cx > SW + 80 || cy < -40 || cy > SH + 40)
         continue;
      int r = (int)(cloudS[c] * 22);
      blob(cx - r, cy + r / 4, r * 2 / 3, r / 2, cloudDark);
      blob(cx + r, cy + r / 4, r * 2 / 3, r / 2, cloudDark);
      blob(cx, cy + r / 5, r, r / 2, cloudDark);
      blob(cx - r * 2 / 3, cy, r * 2 / 3, r / 2, cloudMid);
      blob(cx + r * 2 / 3, cy - r / 8, r * 3 / 4, r / 2, cloudMid);
      blob(cx, cy - r / 3, r * 2 / 3, r / 2, cloudMid);
      blob(cx - r / 4, cy - r / 2, r / 2, r / 3, cloudLit);
      blob(cx + r / 2, cy - r / 3, r / 3, r / 4, cloudLit);
   }
}

// birds: a little V each, beating its wings, crossing the sky
void drawBirds()
{
   for (int b = 0; b < 8; b++)
   {
      birdA[b] = birdA[b] + 0.6 + b * 0.05;
      if (birdA[b] >= 1024)
         birdA[b] = birdA[b] - 1024;
      ffloat e = birdE[b] + isin(frameNo * 3 + birdPh[b]) * 0.01;
      if (domePoint(birdA[b], e) == 0)
         continue;
      int x = domeX;
      int y = domeY;
      if (x < 4 || x >= SW - 4 || y < 2 || y >= SH - 4)
         continue;
      int flap = (frameNo / 3 + b) & 3;
      int wy = 1;
      if (flap == 0)
         wy = -2;
      if (flap == 2)
         wy = 2;
      for (int k = 0; k < 4; k++)
      {
         int yy = y + (wy * k) / 3;
         display[orgOff + yy * stride + x - k] = birdCol;
         display[orgOff + yy * stride + x + k] = birdCol;
      }
      display[orgOff + (y + 1) * stride + x] = birdCol;
   }
}

// ------------------------------------------------------------------ the level

int levelNo;
int startThing;

// the level's things, as the file has them (the game spawns from these)
int thType[200];
ffloat thX[200];
ffloat thY[200];
ffloat thZ[200];
int thA[200];
int thB[200];
int nthings;

char nameBuf[12];

char *levelLump(int n)
{
   nameBuf[0] = 76;
   nameBuf[1] = 69;
   nameBuf[2] = 86;
   nameBuf[3] = 69;
   nameBuf[4] = 76;
   nameBuf[5] = 49 + n;
   nameBuf[6] = 0;
   return nameBuf;
}

void loadLevel(int n)
{
   levelNo = n;
   unpack(levelLump(n));
   nquads = rd16(0);
   nboxes = rd16(2);
   nspheres = rd16(4);
   nthings = rd16(6);
   nzones = rd16(8);
   gridW = rd16(10);
   gridH = rd16(12);
   gridX0 = rd16(14);
   gridZ0 = rd16(16);
   cellSize = rd16(18);
   int listLen = rd16(20);
   fogR = rd16(22);
   fogG = rd16(24);
   fogB = rd16(26);
   skyTopR = rd16(28);
   skyTopG = rd16(30);
   skyTopB = rd16(32);
   skyBotR = rd16(34);
   skyBotG = rd16(36);
   skyBotB = rd16(38);
   fogNear = rd16(40);
   fogFar = rd16(42);
   starsOn = rd16(44);
   scenery = rd16(46);
   birdsOn = rd16(48);
   if (nquads > MAXQ)
      nquads = MAXQ;
   int p = 64;
   for (int i = 0; i < nquads; i++)
   {
      for (int k = 0; k < 4; k++)
      {
         qx[i * 4 + k] = rdpos(p);
         qy[i * 4 + k] = rdpos(p + 2);
         qz[i * 4 + k] = rdpos(p + 4);
         p = p + 6;
      }
      for (int k = 0; k < 4; k++)
      {
         qu[i * 4 + k] = rd16(p);
         qv[i * 4 + k] = rd16(p + 2);
         p = p + 4;
      }
      ffloat nx = rd8s(p);
      ffloat ny = rd8s(p + 1);
      ffloat nz = rd8s(p + 2);
      qnx[i] = nx / 127;
      qny[i] = ny / 127;
      qnz[i] = nz / 127;
      qtex[i] = ubuf[p + 3];
      qlight[i] = ubuf[p + 4];
      qflags[i] = ubuf[p + 5];
      p = p + 6;
   }
   if (nboxes > MAXB)
      nboxes = MAXB;
   for (int i = 0; i < nboxes; i++)
   {
      bx0[i] = rdpos(p);
      by0[i] = rdpos(p + 2);
      bz0[i] = rdpos(p + 4);
      bx1[i] = rdpos(p + 6);
      by1[i] = rdpos(p + 8);
      bz1[i] = rdpos(p + 10);
      bkind[i] = ubuf[p + 12];
      bon[i] = 1;
      p = p + 13;
   }
   for (int i = 0; i < nspheres; i++)
   {
      sx[i] = rdpos(p);
      sy[i] = rdpos(p + 2);
      sz[i] = rdpos(p + 4);
      sr[i] = rdpos(p + 6);
      spull[i] = rdpos(p + 8);
      p = p + 10;
   }
   if (nthings > 200)
      nthings = 200;
   for (int i = 0; i < nthings; i++)
   {
      thType[i] = ubuf[p];
      thX[i] = rdpos(p + 1);
      thY[i] = rdpos(p + 3);
      thZ[i] = rdpos(p + 5);
      thA[i] = rd16(p + 7);
      thB[i] = rd16(p + 9);
      p = p + 11;
   }
   for (int i = 0; i < nzones; i++)
   {
      zx0[i] = rdpos(p);
      zy0[i] = rdpos(p + 2);
      zz0[i] = rdpos(p + 4);
      zx1[i] = rdpos(p + 6);
      zy1[i] = rdpos(p + 8);
      zz1[i] = rdpos(p + 10);
      zmode[i] = ubuf[p + 12];
      zyaw[i] = rd16(p + 13);
      zdist[i] = rdpos(p + 15);
      zheight[i] = rdpos(p + 17);
      zpitch[i] = rd16(p + 19);
      p = p + 21;
   }
   int ncells = gridW * gridH;
   if (ncells > MAXCELL)
      ncells = MAXCELL;
   for (int i = 0; i < ncells; i++)
   {
      cellFirst[i] = rdu16(p);
      cellCount[i] = rdu16(p + 2);
      p = p + 4;
   }
   if (listLen > MAXLIST)
      listLen = MAXLIST;
   for (int i = 0; i < listLen; i++)
   {
      cellList[i] = rdu16(p);
      p = p + 2;
   }
   makeShades();
   makeSky();
   makeScenery();
}

// ------------------------------------------------------------------ drawing the world

// stars: directions on the sky, fixed; and the moon
ffloat starX[90];
ffloat starY[90];
ffloat starZ[90];
int starC[90];

void makeStars()
{
   for (int i = 0; i < 90; i++)
   {
      int a = rnd(1024);
      int e = 40 + rnd(200);
      starX[i] = isin(a) * icos(e);
      starZ[i] = icos(a) * icos(e);
      starY[i] = isin(e);
      starC[i] = rnd(3);
   }
}

// the stars and the moon: directions on the sky, as the clouds
void drawStarsAndMoon()
{
   uint16_t w0 = col(255, 255, 255);
   uint16_t w1 = col(200, 210, 255);
   uint16_t w2 = col(255, 230, 190);
   for (int i = 0; i < 90; i++)
   {
      ffloat z = starX[i] * fX + starY[i] * fY + starZ[i] * fZ;
      if (z < 0.2)
         continue;
      ffloat x = starX[i] * rX + starY[i] * rY + starZ[i] * rZ;
      ffloat y = starX[i] * uX + starY[i] * uY + starZ[i] * uZ;
      int sxp = HALFW + (int)(x * 230 / z);
      int syp = HALFH - (int)(y * 230 / z);
      if (sxp < 1 || sxp >= SW - 1 || syp < 1 || syp >= SH - 1)
         continue;
      uint16_t c = w0;
      if (starC[i] == 1)
         c = w1;
      if (starC[i] == 2)
         c = w2;
      display[orgOff + syp * stride + sxp] = c;
      if ((i & 7) == 0)
      {
         display[orgOff + syp * stride + sxp + 1] = c;
         display[orgOff + (syp + 1) * stride + sxp] = c;
      }
   }
   // the moon, far off toward -x +z, high
   ffloat mx = -0.45;
   ffloat my = 0.55;
   ffloat mz = 0.7;
   ffloat z = mx * fX + my * fY + mz * fZ;
   if (z > 0.3)
   {
      ffloat x = mx * rX + my * rY + mz * rZ;
      ffloat y = mx * uX + my * uY + mz * uZ;
      int cxm = HALFW + (int)(x * 230 / z);
      int cym = HALFH - (int)(y * 230 / z);
      uint16_t mc = col(240, 240, 220);
      uint16_t md = col(200, 200, 190);
      for (int dy = -11; dy <= 11; dy++)
         for (int dx = -11; dx <= 11; dx++)
         {
            int d = dx * dx + dy * dy;
            int xx = cxm + dx;
            int yy = cym + dy;
            if (d <= 121 && xx >= 0 && xx < SW && yy >= 0 && yy < SH)
            {
               uint16_t c = mc;
               if ((dx - 3) * (dx - 3) + (dy + 2) * (dy + 2) < 10 || (dx + 4) * (dx + 4) + (dy - 4) * (dy - 4) < 6)
                  c = md;
               display[orgOff + yy * stride + xx] = c;
            }
         }
   }
}


// the sky's colour a row, and the depth buffer cleared, in one pass
void drawSky()
{
   int i = 0;
   for (int y = 0; y < SH; y++)
   {
      uint16_t c = skyRow[y];
      int dOff = orgOff + y * stride - y * SW;
      int iEnd = i + SW;
      while (i < iEnd)
      {
         display[i + dOff] = c;
         zb[i] = 0;
         i++;
      }
   }
   if (starsOn == 1)
      drawStarsAndMoon();
   if (scenery == 1)
      drawRanges();
   if (scenery >= 1)
      drawClouds();
   if (birdsOn == 1)
      drawBirds();
}

void clearDepth()
{
   for (int i = 0; i < 96000; i++)
      zb[i] = 0;
}

// Wick's candle lights what is near him a little
ffloat heroX;
ffloat heroY;
ffloat heroZ;

int candleBoost(int q)
{
   int b = q * 4;
   ffloat dx = qx[b] - heroX;
   ffloat dz = qz[b] - heroZ;
   if (dx > 3 || dx < -3 || dz > 3 || dz < -3)
      return 0;
   ffloat dy = qy[b] - heroY;
   if (dy > 3 || dy < -3)
      return 0;
   ffloat d = fabsx(dx) + fabsx(dz) + fabsx(dy);
   if (d > 3.5)
      return 0;
   return (int)((3.5 - d) * 1.2);
}

int quadsDrawn;

// one quad of the level, if it faces the camera and is near enough
void drawQuad(int q)
{
   int b = q * 4;
   ffloat ox = qx[b] - camX;
   ffloat oy = qy[b] - camY;
   ffloat oz = qz[b] - camZ;
   // its back is toward the camera
   if (ox * qnx[q] + oy * qny[q] + oz * qnz[q] >= 0)
      return;
   int n = 4;
   if ((qflags[q] & 2) != 0)
      n = 3;
   ffloat zsum = 0;
   int near = 0;
   int far = 0;
   for (int k = 0; k < n; k++)
   {
      ffloat dx = qx[b + k] - camX;
      ffloat dy = qy[b + k] - camY;
      ffloat dz = qz[b + k] - camZ;
      ffloat x = dx * rX + dy * rY + dz * rZ;
      ffloat y = dx * uX + dy * uY + dz * uZ;
      ffloat z = dx * fX + dy * fY + dz * fZ;
      vx[k] = x;
      vy[k] = y;
      vz[k] = z;
      vu[k] = qu[b + k];
      vv[k] = qv[b + k];
      zsum = zsum + z;
      if (z < NEAR)
         near++;
      if (z > FAR)
         far++;
   }
   if (near == n || far == n)
      return;
   texBase = qtex[q] * 1024;
   int light = qlight[q];
   if ((qflags[q] & 1) != 0)
      shadeBase = 15 * 256;
   else
      shadeBase = shadeFor(light + candleBoost(q), zsum / n);
   ghostly = 0;
   if (drawPoly(n) == 1)
      quadsDrawn++;
}

void drawCell(int c, int ix, int iz, int cs, ffloat half)
{
   int cnt = cellCount[c];
   if (cnt == 0)
      return;
   // the cell's middle, seen from the camera (flat on the ground)
   ffloat mx = gridX0 + ix * cs + half - camX;
   ffloat mz = gridZ0 + iz * cs + half - camZ;
   ffloat fwd = mx * fX + mz * fZ;
   ffloat side = mx * rX + mz * rZ;
   if (fwd < -cs * 1.5 && (fY > -0.5 && fY < 0.5))
      return;
   if (fwd > FAR + cs)
      return;
   if (fabsx(side) > fwd * 1.1 + cs * 1.5 && (fY > -0.5 && fY < 0.5))
      return;
   int first = cellFirst[c];
   for (int k = 0; k < cnt; k++)
      drawQuad(cellList[first + k]);
}

// the cells in front of the camera, out to FAR, and their quads
void drawWorld()
{
   quadsDrawn = 0;
   int cs = cellSize;
   int gx = (int)((camX - gridX0) / cs);
   int gz = (int)((camZ - gridZ0) / cs);
   int reach = (int)(FAR / cs) + 1;
   ffloat half = cs * 0.5;
   // nearest cells first: far pixels behind near walls then fail the
   // depth test before their texture is read
   for (int d = 0; d <= reach; d++)
   {
      for (int iz = gz - d; iz <= gz + d; iz++)
      {
         if (iz < 0 || iz >= gridH)
            continue;
         int step = 1;
         if (iz != gz - d && iz != gz + d)
            step = d * 2;
         if (step == 0)
            step = 1;
         for (int ix = gx - d; ix <= gx + d; ix = ix + step)
         {
            if (ix < 0 || ix >= gridW)
               continue;
            drawCell(iz * gridW + ix, ix, iz, cs, half);
         }
      }
   }
}

// ------------------------------------------------------------------ models
//
// A character is drawn from parts: boxes and spheres in its own space
// (x right, y up, z forward), each with a flat colour, turned by a pitch
// round its pivot, then put into the world by the model's basis: its
// place (mx..) and its right (ax..), up (bx..) and forward (cx..).

ffloat mX;
ffloat mY;
ffloat mZ;
ffloat aX;
ffloat aY;
ffloat aZ;
ffloat bX;
ffloat bY;
ffloat bZ;
ffloat dX;
ffloat dY;
ffloat dZ;
ffloat mScale;
int modelGhost;
int modelFlash;
int modelLight;

// the model's basis: standing at (x, y, z), facing yaw, its up the world's
void modelAt(ffloat x, ffloat y, ffloat z, int yaw)
{
   mX = x;
   mY = y;
   mZ = z;
   ffloat s = isin(yaw);
   ffloat c = icos(yaw);
   dX = s;
   dY = 0;
   dZ = c;
   aX = c;
   aY = 0;
   aZ = -s;
   bX = 0;
   bY = 1;
   bZ = 0;
   mScale = 1;
   modelGhost = 0;
   modelFlash = 0;
   modelLight = 0;
}

// the model's basis on a moonlet: up (ux..), forward (fx..) along the ground
void modelOn(ffloat x, ffloat y, ffloat z, ffloat ux, ffloat uy, ffloat uz, ffloat fx, ffloat fy, ffloat fz)
{
   mX = x;
   mY = y;
   mZ = z;
   bX = ux;
   bY = uy;
   bZ = uz;
   dX = fx;
   dY = fy;
   dZ = fz;
   // right = up x forward
   aX = uy * fz - uz * fy;
   aY = uz * fx - ux * fz;
   aZ = ux * fy - uy * fx;
   mScale = 1;
   modelGhost = 0;
   modelFlash = 0;
   modelLight = 0;
}

// the corners of the part being drawn, in view space
float bvx[8];
float bvy[8];
float bvz[8];
ffloat bwx[8];
ffloat bwy[8];
ffloat bwz[8];

// a point of the model's space into view space, as corner i
void modelPoint(int i, ffloat lx, ffloat ly, ffloat lz)
{
   lx = lx * mScale;
   ly = ly * mScale;
   lz = lz * mScale;
   ffloat wx = mX + aX * lx + bX * ly + dX * lz;
   ffloat wy = mY + aY * lx + bY * ly + dY * lz;
   ffloat wz = mZ + aZ * lx + bZ * ly + dZ * lz;
   bwx[i] = wx;
   bwy[i] = wy;
   bwz[i] = wz;
   ffloat ox = wx - camX;
   ffloat oy = wy - camY;
   ffloat oz = wz - camZ;
   bvx[i] = ox * rX + oy * rY + oz * rZ;
   bvy[i] = ox * uX + oy * uY + oz * uZ;
   bvz[i] = ox * fX + oy * fY + oz * fZ;
}

// the light of a face of the model, from its world normal
int faceLight(int a, int b, int c)
{
   ffloat e1x = bwx[b] - bwx[a];
   ffloat e1y = bwy[b] - bwy[a];
   ffloat e1z = bwz[b] - bwz[a];
   ffloat e2x = bwx[c] - bwx[a];
   ffloat e2y = bwy[c] - bwy[a];
   ffloat e2z = bwz[c] - bwz[a];
   ffloat nx = e1y * e2z - e1z * e2y;
   ffloat ny = e1z * e2x - e1x * e2z;
   ffloat nz = e1x * e2y - e1y * e2x;
   ffloat l = fabsx(nx) + fabsx(ny) + fabsx(nz);
   if (l < 0.00001)
      return 8;
   // the moon from above and the left, a little from the camera
   ffloat d = (-nx * 0.4 + ny * 0.8 - nz * 0.3) / l;
   int lv = 7 + (int)(d * 7) + modelLight;
   return clampi(lv, 2, 14);
}

// draws face (a, b, c, d) of the corners, if it faces the camera
void modelFace(int a, int b, int c, int d, int colour)
{
   // facing: the normal against the way from the camera
   ffloat e1x = bwx[b] - bwx[a];
   ffloat e1y = bwy[b] - bwy[a];
   ffloat e1z = bwz[b] - bwz[a];
   ffloat e2x = bwx[d] - bwx[a];
   ffloat e2y = bwy[d] - bwy[a];
   ffloat e2z = bwz[d] - bwz[a];
   ffloat nx = e1y * e2z - e1z * e2y;
   ffloat ny = e1z * e2x - e1x * e2z;
   ffloat nz = e1x * e2y - e1y * e2x;
   ffloat tx = bwx[a] - camX;
   ffloat ty = bwy[a] - camY;
   ffloat tz = bwz[a] - camZ;
   if (nx * tx + ny * ty + nz * tz >= 0)
      return;
   vx[0] = bvx[a];
   vy[0] = bvy[a];
   vz[0] = bvz[a];
   vx[1] = bvx[b];
   vy[1] = bvy[b];
   vz[1] = bvz[b];
   vx[2] = bvx[c];
   vy[2] = bvy[c];
   vz[2] = bvz[c];
   vx[3] = bvx[d];
   vy[3] = bvy[d];
   vz[3] = bvz[d];
   for (int k = 0; k < 4; k++)
   {
      vu[k] = 0;
      vv[k] = 0;
   }
   texBase = -1;
   flatCol = colour;
   if (modelFlash == 1)
      flatCol = C_WHITE;
   int lv = faceLight(a, b, d);
   ffloat z = (bvz[a] + bvz[c]) * 0.5;
   shadeBase = shadeFor(lv, z);
   ghostly = modelGhost;
   drawPoly(4);
}

// a box: centre (x, y, z), half sizes (hx, hy, hz), pitched by `pitch`
// round the point (0, py, pz) of the model
void part(ffloat x, ffloat y, ffloat z, ffloat hx, ffloat hy, ffloat hz, int pitch, ffloat py, ffloat pz, int colour)
{
   ffloat s = isin(pitch);
   ffloat c = icos(pitch);
   for (int i = 0; i < 8; i++)
   {
      ffloat lx = x - hx;
      if ((i & 1) != 0)
         lx = x + hx;
      ffloat ly = y - hy;
      if ((i & 2) != 0)
         ly = y + hy;
      ffloat lz = z - hz;
      if ((i & 4) != 0)
         lz = z + hz;
      if (pitch != 0)
      {
         ffloat ry = ly - py;
         ffloat rz = lz - pz;
         ly = py + ry * c - rz * s;
         lz = pz + ry * s + rz * c;
      }
      modelPoint(i, lx, ly, lz);
   }
   // corner i: bit 0 x+, bit 1 y+, bit 2 z+
   modelFace(2, 6, 7, 3, colour);   // top
   modelFace(0, 1, 5, 4, colour);   // bottom
   modelFace(0, 2, 3, 1, colour);   // back (-z)
   modelFace(4, 5, 7, 6, colour);   // front (+z)
   modelFace(1, 3, 7, 5, colour);   // right (+x)
   modelFace(0, 4, 6, 2, colour);   // left (-x)
}

// a low sphere: a top, three rings of 8 corners (at 45, 90 and 135
// degrees from the top), a bottom; radii rx, ry, rz
float sbx[26];
float sby[26];
float sbz[26];
ffloat swx[26];
ffloat swy[26];
ffloat swz[26];

void ballPoint(int i, ffloat lx, ffloat ly, ffloat lz)
{
   modelPoint(0, lx, ly, lz);
   sbx[i] = bvx[0];
   sby[i] = bvy[0];
   sbz[i] = bvz[0];
   swx[i] = bwx[0];
   swy[i] = bwy[0];
   swz[i] = bwz[0];
}

// face (a, b, c, d) of the sphere's corners, put in corners 0..3
void ballFace(int a, int b, int c, int d, int colour)
{
   bvx[0] = sbx[a];
   bvy[0] = sby[a];
   bvz[0] = sbz[a];
   bwx[0] = swx[a];
   bwy[0] = swy[a];
   bwz[0] = swz[a];
   bvx[1] = sbx[b];
   bvy[1] = sby[b];
   bvz[1] = sbz[b];
   bwx[1] = swx[b];
   bwy[1] = swy[b];
   bwz[1] = swz[b];
   bvx[2] = sbx[c];
   bvy[2] = sby[c];
   bvz[2] = sbz[c];
   bwx[2] = swx[c];
   bwy[2] = swy[c];
   bwz[2] = swz[c];
   bvx[3] = sbx[d];
   bvy[3] = sby[d];
   bvz[3] = sbz[d];
   bwx[3] = swx[d];
   bwy[3] = swy[d];
   bwz[3] = swz[d];
   modelFace(0, 1, 2, 3, colour);
}

// a small round part (6 corners round, a top and a bottom: 12 faces), for
// hands, feet, ears, the tail: round without costing a full ball
void pebble(ffloat x, ffloat y, ffloat z, ffloat rx, ffloat ry, ffloat rz, int colour)
{
   ballPoint(0, x, y + ry, z);
   for (int k = 0; k < 6; k++)
   {
      int a = k * 171;
      ballPoint(1 + k, x + isin(a) * rx, y, z + icos(a) * rz);
   }
   ballPoint(7, x, y - ry, z);
   for (int k = 0; k < 6; k++)
   {
      int k2 = k + 1;
      if (k2 == 6)
         k2 = 0;
      ballFace(0, 1 + k, 1 + k2, 1 + k2, colour);
      ballFace(1 + k, 7, 7, 1 + k2, colour);
   }
}

void ball(ffloat x, ffloat y, ffloat z, ffloat rx, ffloat ry, ffloat rz, int colour)
{
   ballPoint(0, x, y + ry, z);
   for (int ring = 0; ring < 3; ring++)
   {
      int theta = 128 + ring * 128;
      ffloat cy = icos(theta);
      ffloat sr2 = isin(theta);
      for (int k = 0; k < 8; k++)
      {
         int a = k * 128;
         ballPoint(1 + ring * 8 + k, x + isin(a) * sr2 * rx, y + cy * ry, z + icos(a) * sr2 * rz);
      }
   }
   ballPoint(25, x, y - ry, z);
   for (int k = 0; k < 8; k++)
   {
      int k2 = (k + 1) & 7;
      ballFace(0, 1 + k, 1 + k2, 1 + k2, colour);
      ballFace(1 + k, 9 + k, 9 + k2, 1 + k2, colour);
      ballFace(9 + k, 17 + k, 17 + k2, 9 + k2, colour);
      ballFace(17 + k, 25, 25, 17 + k2, colour);
   }
}


