// ------------------------------------------------------------------ the sky's sun and clouds

int cloudA[10];
int cloudE[10];
int cloudS[10];

void makeClouds()
{
   for (int c = 0; c < 10; c++)
   {
      cloudA[c] = rnd(1024);
      cloudE[c] = 30 + rnd(70);
      cloudS[c] = 14 + rnd(18);
   }
}

// a filled ellipse, only over the sky
void skyBlob(int cx, int cy, int rx, int ry, uint16_t c)
{
   if (rx < 1 || ry < 1)
      return;
   for (int dy = -ry; dy <= ry; dy++)
   {
      int y = cy + dy;
      if (y < 0 || y >= SH)
         continue;
      int half = 0;
      while (half < rx && (half + 1) * (half + 1) * ry * ry <= rx * rx * (ry * ry - dy * dy))
         half++;
      int x0 = imax(0, cx - half);
      int x1 = imin(SW - 1, cx + half);
      int o = orgOff + y * stride;
      int zi = y * SW;
      for (int x = x0; x <= x1; x++)
         if (zdep[zi + x] == 255)
            display[o + x] = c;
   }
}

// the clouds sit on the sky by their direction (and drift); the sun too
void drawSkyThings()
{
   uint16_t lit = col(mixc(255, skyBotR, 40), mixc(255, skyBotG, 40), mixc(255, skyBotB, 40));
   uint16_t mid = col(mixc(235, skyBotR, 100), mixc(235, skyBotG, 100), mixc(245, skyBotB, 80));
   uint16_t dark = col(mixc(200, skyTopR, 110), mixc(200, skyTopG, 110), mixc(220, skyTopB, 100));
   // the sun (or the moon at night): toward the south-east, low
   int sunA = 384;
   int d = angleDiff(camYaw, sunA);
   if (d > -200 && d < 200)
   {
      int sx = HALFW + d * 230 / 180;
      int sy = 120 + camPitch - 52 + (((sx - HALFW) * camBank) >> 8);
      uint16_t sc = col(255, 250, 220);
      uint16_t glow = col(mixc(255, skyBotR, 120), mixc(240, skyBotG, 120), mixc(200, skyBotB, 120));
      if (lightPct < 70)
      {
         sc = col(240, 240, 255);
         glow = col(skyBotR + 20, skyBotG + 20, skyBotB + 40);
      }
      skyBlob(sx, sy, 24, 24, glow);
      skyBlob(sx, sy, 13, 13, sc);
   }
   for (int c = 0; c < 10; c++)
   {
      if ((frameNo & 3) == 0)
         cloudA[c] = (cloudA[c] + 1) & 1023;
      int dd = angleDiff(camYaw, cloudA[c]);
      if (dd < -220 || dd > 220)
         continue;
      int cx = HALFW + dd * 230 / 180;
      int cy = 120 + camPitch - cloudE[c] + (((cx - HALFW) * camBank) >> 8);
      int r = cloudS[c];
      skyBlob(cx - r, cy + r / 4, r * 2 / 3, r / 3, dark);
      skyBlob(cx + r, cy + r / 4, r * 2 / 3, r / 3, dark);
      skyBlob(cx, cy, r, r / 2, mid);
      skyBlob(cx - r / 2, cy - r / 5, r * 2 / 3, r / 3, mid);
      skyBlob(cx + r / 3, cy - r / 3, r / 2, r / 3, lit);
   }
}

