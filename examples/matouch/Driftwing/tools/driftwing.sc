// ------------------------------------------------------------------ the plane

#define CRUISE 26000
#define BOOSTED 42000

int plX;        // 16.16 cells
int plY;
int plAlt;      // quarters of a cell
int plYaw;
int plBank;     // -256..256
int plClimb;    // quarters of a cell a step
int plSpeed;    // 16.16 cells a step
int boost;      // 0..1000
int crashed;    // >0: steps since the crash
int bumped;     // >0: steps before a balloon can knock the plane again
int nextGate;
int gatesDone;
int lettersGot;
int score;
int timeLeft;   // steps (30 a second)
int routeDone;
int stepNo;
int showMs;
int msFrame;

int kUp;
int kDown;
int kLeft;
int kRight;
int kBoost;
int menuKey;
// O: the autopilot flies to the gates (for tests and for showing off)
int autoPilot;

// sparks: a gate passed, a letter gathered, a crash
int pX[MAXP];
int pY[MAXP];
int pA[MAXP];
int pVX[MAXP];
int pVY[MAXP];
int pVA[MAXP];
int pLife[MAXP];
// 1: a trail (stays where it is, fades), 0: a spark (falls)
int pTrail[MAXP];
uint16_t pCol[MAXP];

void spark(int x, int y, int alt, int n, uint16_t c, int speed)
{
   for (int k = 0; k < n; k++)
      for (int i = 0; i < MAXP; i++)
         if (pLife[i] <= 0)
         {
            pX[i] = x << 8;
            pY[i] = y << 8;
            pA[i] = alt << 6;
            pVX[i] = rnd(speed * 2 + 1) - speed;
            pVY[i] = rnd(speed * 2 + 1) - speed;
            pVA[i] = rnd(speed * 2 + 1) - speed / 2;
            pLife[i] = 20 + rnd(20);
            pCol[i] = c;
            pTrail[i] = 0;
            break;
         }
}

// a puff of the wingtips' trails, where the tip is (cells x 256)
void trail(int x8, int y8, int alt)
{
   for (int i = 0; i < MAXP; i++)
      if (pLife[i] <= 0)
      {
         pX[i] = x8;
         pY[i] = y8;
         pA[i] = alt << 6;
         pVX[i] = 0;
         pVY[i] = 0;
         pVA[i] = 0;
         pLife[i] = 16;
         pCol[i] = col(240, 248, 255);
         pTrail[i] = 1;
         return;
      }
}

void trails()
{
   if (crashed > 0)
      return;
   if (kBoost == 0 && iabs(plBank) < 170)
      return;
   // the wingtips: 2.2 cells either side, across the heading
   int rx = icos8(plYaw);
   int ry = -isin8(plYaw);
   int x8 = plX >> 8;
   int y8 = plY >> 8;
   int lift = (plBank * 8) >> 8;
   trail(x8 + ((rx * 560) >> 8), y8 + ((ry * 560) >> 8), plAlt + 2 - lift);
   trail(x8 - ((rx * 560) >> 8), y8 - ((ry * 560) >> 8), plAlt + 2 + lift);
}

void updateSparks()
{
   for (int i = 0; i < MAXP; i++)
   {
      if (pLife[i] <= 0)
         continue;
      pLife[i] = pLife[i] - 1;
      pX[i] = pX[i] + pVX[i];
      pY[i] = pY[i] + pVY[i];
      pA[i] = pA[i] + pVA[i];
      if (pTrail[i] == 0)
         pVA[i] = pVA[i] - 2;
   }
}

void drawSparks()
{
   for (int i = 0; i < MAXP; i++)
   {
      if (pLife[i] <= 0)
         continue;
      if (projectF(pX[i] >> 4, pY[i] >> 4, pA[i] >> 6) == 1)
      {
         int size = clampi(projScale / 120, 1, 4);
         if (pTrail[i] == 1)
            size = clampi((projScale * pLife[i]) >> 11, 1, 3);
         dot(projX, projY, size, zqOf(projZ), pCol[i]);
      }
   }
}

void startRoute()
{
   plX = startX << 16;
   plY = startY << 16;
   plAlt = startAlt;
   plYaw = startHd;
   plBank = 0;
   plClimb = 0;
   plSpeed = CRUISE;
   boost = 1000;
   crashed = 0;
   bumped = 0;
   nextGate = 0;
   gatesDone = 0;
   lettersGot = 0;
   timeLeft = routeSeconds * 30;
   routeDone = 0;
   for (int i = 0; i < MAXP; i++)
      pLife[i] = 0;
}

// back after a crash: at the last gate passed (or the start), facing the next
void respawn()
{
   if (nGates == 0)
   {
      // free flight: up again where it fell, the same way
      plAlt = imax(groundAt(plX >> 16, plY >> 16) + 60, (SEA << 1) + 60);
      plBank = 0;
      plClimb = 0;
      plSpeed = CRUISE;
      crashed = 0;
      return;
   }
   if (gatesDone > 0)
   {
      int g = gatesDone - 1;
      plX = gateX[g] << 16;
      plY = gateY[g] << 16;
      plAlt = gateAlt[g];
   }
   else
   {
      plX = startX << 16;
      plY = startY << 16;
      plAlt = startAlt;
   }
   int g2 = imin(nextGate, nGates - 1);
   plYaw = iangle(wrapDiff(plX >> 16, gateX[g2]), wrapDiff(plY >> 16, gateY[g2]));
   plBank = 0;
   plClimb = 0;
   plSpeed = CRUISE;
   crashed = 0;
}

void updatePlane()
{
   if (crashed > 0)
   {
      crashed++;
      if (crashed > 60)
         respawn();
      return;
   }
   // banking and turning
   int target = 0;
   if (kLeft == 1)
      target = -230;
   if (kRight == 1)
      target = 230;
   plBank = plBank + (target - plBank) / 6;
   plYaw = (plYaw + plBank / 26) & 1023;
   // climbing and diving
   int ct = 0;
   if (kUp == 1)
      ct = 6;
   if (kDown == 1)
      ct = -7;
   // the climb follows the stick smoothly
   if (plClimb < ct)
      plClimb++;
   if (plClimb > ct)
      plClimb--;
   // speed: boost while the gauge lasts, a dive speeds up, a climb slows
   int want = CRUISE;
   if (kBoost == 1 && boost > 0)
   {
      want = BOOSTED;
      boost = boost - 12;
   }
   else if (boost < 1000)
      boost = boost + 3;
   want = want - plClimb * 1400;
   plSpeed = plSpeed + (want - plSpeed) / 10;
   int fx = isin8(plYaw);
   int fy = icos8(plYaw);
   plX = (plX + ((fx * plSpeed) >> 8)) & ((MAPN << 16) - 1);
   plY = (plY + ((fy * plSpeed) >> 8)) & ((MAPN << 16) - 1);
   plAlt = plAlt + plClimb;
   if (plAlt > 600)
      plAlt = 600;
   // the ground: a crash
   int g = groundAt(plX >> 16, plY >> 16);
   if (plAlt < g + 6 || plAlt < (SEA << 1) + 4)
   {
      crashed = 1;
      spark(plX >> 16, plY >> 16, plAlt, 30, col(255, 180, 60), 50);
      spark(plX >> 16, plY >> 16, plAlt, 14, col(80, 70, 70), 40);
   }
}

// gates, letters, balloons: what the plane touches
void touches()
{
   if (crashed > 0)
      return;
   int x = plX >> 16;
   int y = plY >> 16;
   if (nextGate < nGates)
   {
      int g = nextGate;
      int dx = wrapDiff(x, gateX[g]);
      int dy = wrapDiff(y, gateY[g]);
      int da = (plAlt - gateAlt[g]) >> 2;
      if (dx > -7 && dx < 7 && dy > -7 && dy < 7 && da > -8 && da < 8)
      {
         nextGate++;
         gatesDone++;
         timeLeft = timeLeft + 3 * 30;
         score = score + 500;
         spark(gateX[g], gateY[g], gateAlt[g], 36, col(255, 230, 90), 60);
         if (nextGate >= nGates)
            routeDone = 1;
      }
   }
   for (int i = 0; i < nLetters; i++)
   {
      if (letterGot[i] == 1)
         continue;
      int dx = wrapDiff(x, letterX[i]);
      int dy = wrapDiff(y, letterY[i]);
      int da = (plAlt - letterAlt[i]) >> 2;
      if (dx > -4 && dx < 4 && dy > -4 && dy < 4 && da > -5 && da < 5)
      {
         letterGot[i] = 1;
         lettersGot++;
         score = score + 100;
         spark(letterX[i], letterY[i], letterAlt[i], 12, col(255, 255, 230), 40);
      }
   }
   if (bumped > 0)
   {
      bumped--;
      return;
   }
   for (int i = 0; i < nBalloons; i++)
   {
      int dx = wrapDiff(x, balX[i]);
      int dy = wrapDiff(y, balY[i]);
      int da = (plAlt - balAlt[i]) >> 2;
      if (dx > -3 && dx < 3 && dy > -3 && dy < 3 && da > -2 && da < 9)
      {
         // a bump: knocked aside, a little time lost; then a moment's
         // grace, so one balloon is one bump, not one a step
         plYaw = (plYaw + 200) & 1023;
         plSpeed = CRUISE / 2;
         timeLeft = timeLeft - 60;
         bumped = 45;
         spark(x, y, plAlt, 10, col(255, 120, 140), 40);
         break;
      }
   }
}

// the camera: behind and above the plane, never inside a hill
// the camera's views (C changes it): how far behind the plane (cells),
// how high over it (quarters of a cell), where the horizon is (pixels,
// so the plane sits a little under the middle); U and J tilt it
int camView;
int camTilt;
int camMsg;
// how far the ground pushes the camera up over its view's height (eased,
// so a passing hill does not kick it)
int camPush;

int viewDist(int v)
{
   if (v == 1)
      return 17;
   if (v == 2)
      return 12;
   if (v == 3)
      return 8;
   return 11;
}

int viewHeight(int v)
{
   if (v == 1)
      return 20;
   if (v == 2)
      return 48;
   if (v == 3)
      return 2;
   return 8;
}

int viewPitch(int v)
{
   if (v == 1)
      return -23;
   if (v == 2)
      return -185;
   if (v == 3)
      return 31;
   return 3;
}

char *viewName(int v)
{
   if (v == 1)
      return "CAMERA: FAR";
   if (v == 2)
      return "CAMERA: HIGH";
   if (v == 3)
      return "CAMERA: LOW";
   return "CAMERA: CHASE";
}

void updateCamera()
{
   // the camera turns after the plane: in a turn the plane is seen a
   // little from the side
   camYaw = (camYaw + angleDiff(camYaw, plYaw) / 4) & 1023;
   int fx = isin8(camYaw);
   int fy = icos8(camYaw);
   int d = viewDist(camView);
   camX = plX - fx * d * 256;
   camY = plY - fy * d * 256;
   int a = plAlt + viewHeight(camView);
   // above the ground round the camera, not only under it
   int g = 0;
   for (int k = -4; k <= 4; k = k + 4)
   {
      g = imax(g, groundAt((camX >> 16) + k, camY >> 16));
      g = imax(g, groundAt(camX >> 16, (camY >> 16) + k));
   }
   g = g + 12;
   // the camera holds the plane's height exactly (so the plane stays put
   // on the screen, shifting only with the pitch); only the ground's
   // push is eased
   int push = g - a;
   if (push < 0)
      push = 0;
   camPush = camPush + (push - camPush) / 3;
   camAlt = a + camPush;
   int pitch = viewPitch(camView) + camTilt - plClimb * 2;
   camPitch = camPitch + (pitch - camPitch) / 3;
   camBank = -plBank / 3;
}

// ------------------------------------------------------------------ drawing the things

// a gate: a ring of glowing dots, upright, square to the way through it;
// a little flag pole under it, down to the ground
void drawGate(int g, int on)
{
   if (project(gateX[g], gateY[g], gateAlt[g]) == 0)
      return;
   if (projZ > 220 * 256)
      return;
   uint16_t c = col(110, 170, 255);
   uint16_t c2 = col(40, 70, 190);
   if (on == 1)
   {
      c = col(255, 220, 70);
      c2 = col(230, 110, 30);
      if ((frameNo & 4) == 0)
         c = col(255, 250, 190);
   }
   // across the way: the heading turned a quarter
   int sx = icos8(gateHd[g]);
   int sy = -isin8(gateHd[g]);
   int gx16 = gateX[g] << 4;
   int gy16 = gateY[g] << 4;
   for (int k = 0; k < 32; k++)
   {
      int a = k * 32;
      int s6 = isin8(a) * 6;
      int ox = (sx * s6) >> 12;
      int oy = (sy * s6) >> 12;
      int oa = (icos8(a) * 24) >> 8;
      if (projectF(gx16 + ox, gy16 + oy, gateAlt[g] + oa) == 0)
         continue;
      int size = clampi(projScale / 100, 1, 6);
      int zq = zqOf(projZ);
      dot(projX, projY, size + 2, zq, c2);
      dot(projX, projY, size, zq, c);
   }
}

// cars on the city's streets (every 14 cells): each one runs along its
// lane, there and back, its place set by the step count alone
void drawCars()
{
   if (iabs(wrapDiff(plX >> 16, CITY_X)) > CITY_R + 80 || iabs(wrapDiff(plY >> 16, CITY_Y)) > CITY_R + 80)
      return;
   int span = CITY_R * 24;   // the lane's length, 16ths of a cell
   for (int i = 0; i < 26; i++)
   {
      int lane = (i >> 1) % 9 - 4;
      int p = (stepNo * (3 + (i % 3)) + i * 977) % (span * 2);
      if (p >= span)
         p = span * 2 - p;
      int off = p - span / 2;
      int wx16;
      int wy16;
      if ((i & 1) == 0)
      {
         // along x, on a street's line (they lie every 14 cells)
         wx16 = CITY_X * 16 + off;
         wy16 = ((CITY_Y / 14 + lane) * 14 + 1) * 16;
      }
      else
      {
         wx16 = ((CITY_X / 14 + lane) * 14 + 1) * 16;
         wy16 = CITY_Y * 16 + off;
      }
      // only where the street exists (flat city ground)
      int g = groundAt(wx16 >> 4, wy16 >> 4);
      if (g > (SEA + 10) << 1 || g < (SEA + 4) << 1)
         continue;
      if (projectF(wx16 & (MAPN * 16 - 1), wy16 & (MAPN * 16 - 1), g + 1) == 0)
         continue;
      if (projZ > 120 * 256)
         continue;
      uint16_t c = col(240, 240, 240);
      if (i % 5 == 1)
         c = col(255, 220, 60);
      if (i % 5 == 2)
         c = col(230, 60, 50);
      if (i % 5 == 3)
         c = col(80, 160, 255);
      if (i % 5 == 4)
         c = col(60, 200, 120);
      dot(projX, projY, clampi(projScale / 110, 1, 3), zqOf(projZ), c);
   }
   // the towers' lights: red, blinking in turn
   for (int i = 0; i < nTowers; i++)
   {
      if (((frameNo >> 3) + i) % 3 == 0)
         continue;
      if (project(towerX[i], towerY[i], towerAlt[i] + 2) == 0)
         continue;
      int zq = zqOf(projZ) - 1;
      dot(projX, projY, clampi(projScale / 60, 1, 4), zq, col(255, 50, 40));
   }
}

void drawThings()
{
   // the gates still to fly: the next one bright, the one after dim
   if (nextGate + 1 < nGates)
      drawGate(nextGate + 1, 0);
   if (nextGate < nGates)
      drawGate(nextGate, 1);
   // letters
   for (int i = 0; i < nLetters; i++)
   {
      if (letterGot[i] == 1)
         continue;
      if (project(letterX[i], letterY[i], letterAlt[i]) == 0)
         continue;
      if (projZ > 140 * 256)
         continue;
      int k = clampi(projScale, 30, 700);
      drawSpriteScaled(S_LETTER, (frameNo >> 3) & 1, projX, projY, k, zqOf(projZ));
   }
   // balloons drifting up and down
   for (int i = 0; i < nBalloons; i++)
   {
      int bob = (isin8(frameNo * 3 + i * 97) * 6) >> 8;
      if (project(balX[i], balY[i], balAlt[i] + bob) == 0)
         continue;
      int k = clampi(projScale, 20, 1000);
      drawSpriteScaled(S_BALLOON, 0, projX, projY, k, zqOf(projZ));
   }
   drawCars();
   drawSparks();
}

// the birds: a flock in the sky ahead, beating their wings
void drawBirds()
{
   for (int b = 0; b < 6; b++)
   {
      int a = (frameNo * 2 + b * 170) & 1023;
      int d = angleDiff(camYaw, a);
      if (d < -200 || d > 200)
         continue;
      int x = HALFW + d * 230 / 180 + (isin8(frameNo * 5 + b * 60) >> 4);
      int y = 120 + camPitch - 70 - b * 5 + (((x - HALFW) * camBank) >> 8);
      if (x < 0 || x > SW - 14 || y < 0 || y > SH - 8)
         continue;
      if (zdep[y * SW + x] != 255)
         continue;
      drawSprite(S_BIRD, ((frameNo >> 2) + b) & 1, x, y);
   }
}

// darker: a pixel of the ground in the plane's shadow (RGB565 byte-swapped)
uint16_t darker(uint16_t c)
{
   int v = ((c & 255) << 8) | (c >> 8);
   v = (v >> 1) & 0x7BEF;
   v = v + ((v >> 2) & 0x39E7);
   return ((v & 255) << 8) | (v >> 8);
}

// the plane's shadow on the ground under it (or on the sea): an ellipse,
// smaller and fainter the higher it flies
void drawShadow()
{
   if (crashed > 0)
      return;
   int g = imax(groundAt(plX >> 16, plY >> 16), SEA << 1);
   int above = plAlt - g;
   if (above > 120)
      return;
   if (projectF(plX >> 12, plY >> 12, g) == 0)
      return;
   int zq = zqOf(projZ);
   // the wings are 4.6 cells across, a little less as it climbs
   int rx = (230 * FOCAL / (projZ >> 4)) >> 4;
   rx = rx * (160 - above / 2) / 160;
   int ry = rx / 4 + 1;
   int cx = projX;
   int cy = projY;
   for (int dy = -ry; dy <= ry; dy++)
   {
      int y = cy + dy;
      if (y < 0 || y >= SH)
         continue;
      int half = rx - (rx * dy * dy) / (ry * ry);
      int o = orgOff + y * stride;
      int zi = y * SW;
      for (int x = imax(0, cx - half); x <= imin(SW - 1, cx + half); x++)
      {
         int zd = zdep[zi + x];
         if (zd != 255 && zd + 3 >= zq)
            display[o + x] = darker(display[o + x]);
      }
   }
}

// ------------------------------------------------------------------ the plane in 3D

// The plane is a mesh (MESH in the WAD: 262 corners, 422 triangles, made
// by tools/sprites.py), drawn every picture: turned by its bank, its climb
// and its heading against the camera's, the propeller's blades turning,
// each triangle lit by the sun (its side toward the camera), painted far
// to near, and hidden where nearer ground is in front. It is where the
// plane is: the same projection as the ground, so its height over the
// hills is what it looks.
#define MAXV 300
#define MAXT 460
int nVerts;
int nTris;
int mvX[MAXV];
int mvY[MAXV];
int mvZ[MAXV];
int mvPart[MAXV];
int mtA[MAXT];
int mtB[MAXT];
int mtC[MAXT];
int mtR[MAXT];
int mtG[MAXT];
int mtBl[MAXT];
int mtPart[MAXT];
// a picture's: turned (128ths of a unit), from the camera (cells x 256),
// on the screen (16ths of a pixel)
int rvX[MAXV];
int rvY[MAXV];
int rvZ[MAXV];
int cvX[MAXV];
int cvY[MAXV];
int cvZ[MAXV];
int svX[MAXV];
int svY[MAXV];
int bucketHead[64];
int bucketNext[MAXT];
int propAngle;

int s16(int v)
{
   if (v >= 32768)
      return v - 65536;
   return v;
}

void loadMesh()
{
   int p = wadFind("MESH");
   int nv = wd16(p);
   nVerts = imin(MAXV, nv);
   nTris = imin(MAXT, wd16(p + 2));
   int q = p + 4;
   for (int i = 0; i < nVerts; i++)
   {
      mvX[i] = s16(wd16(q));
      mvY[i] = s16(wd16(q + 2));
      mvZ[i] = s16(wd16(q + 4));
      mvPart[i] = wad[q + 6];
      q = q + 8;
   }
   q = p + 4 + nv * 8;
   for (int t = 0; t < nTris; t++)
   {
      mtA[t] = wd16(q);
      mtB[t] = wd16(q + 2);
      mtC[t] = wd16(q + 4);
      mtR[t] = wad[q + 6];
      mtG[t] = wad[q + 7];
      mtBl[t] = wad[q + 8];
      mtPart[t] = wad[q + 9];
      q = q + 10;
   }
}

// a triangle (16ths of a pixel), every pixel whose middle is in it, where
// nothing nearer is (zq); dith: every other pixel (the propeller's blur)
void fillTri(int x0, int y0, int x1, int y1, int x2, int y2, uint16_t c, int dith, int zq)
{
   int area = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0);
   if (area == 0)
      return;
   if (area < 0)
   {
      int t = x1;
      x1 = x2;
      x2 = t;
      t = y1;
      y1 = y2;
      y2 = t;
   }
   int minx = imax(0, imin(x0, imin(x1, x2)) >> 4);
   int maxx = imin(SW - 1, (imax(x0, imax(x1, x2)) + 15) >> 4);
   int miny = imax(0, imin(y0, imin(y1, y2)) >> 4);
   int maxy = imin(SH - 1, (imax(y0, imax(y1, y2)) + 15) >> 4);
   if (minx > maxx || miny > maxy)
      return;
   int px = minx * 16 + 8;
   int py = miny * 16 + 8;
   int e0 = (x2 - x1) * (py - y1) - (y2 - y1) * (px - x1);
   int e1 = (x0 - x2) * (py - y2) - (y0 - y2) * (px - x2);
   int e2 = (x1 - x0) * (py - y0) - (y1 - y0) * (px - x0);
   int ex0 = (y1 - y2) * 16;
   int ex1 = (y2 - y0) * 16;
   int ex2 = (y0 - y1) * 16;
   int ey0 = (x2 - x1) * 16;
   int ey1 = (x0 - x2) * 16;
   int ey2 = (x1 - x0) * 16;
   for (int y = miny; y <= maxy; y++)
   {
      int a0 = e0;
      int a1 = e1;
      int a2 = e2;
      int o = orgOff + y * stride;
      int zi = y * SW;
      for (int x = minx; x <= maxx; x++)
      {
         if ((a0 | a1 | a2) >= 0)
         {
            if (zq < zdep[zi + x])
            {
               if (dith == 0 || ((x + y + frameNo) & 1) == 0)
                  display[o + x] = c;
            }
         }
         a0 = a0 + ex0;
         a1 = a1 + ex1;
         a2 = a2 + ex2;
      }
      e0 = e0 + ey0;
      e1 = e1 + ey1;
      e2 = e2 + ey2;
   }
}

void drawPlane()
{
   if (crashed > 0)
      return;
   propAngle = (propAngle + 170) & 1023;
   // its bank (up to 60 degrees), its climb (up to 30), its heading
   // against the camera's
   int ba = (plBank * 3) >> 2;
   int pa = plClimb * 11;
   int ya = angleDiff(camYaw, plYaw);
   int sb = isin8(ba);
   int cb = icos8(ba);
   int sp = isin8(pa);
   int cp = icos8(pa);
   int sy = isin8(ya);
   int cy = icos8(ya);
   int spr = isin8(propAngle);
   int cpr = icos8(propAngle);
   // where it is from the camera: across, up, ahead (cells x 256)
   int fx = isin8(camYaw);
   int fy = icos8(camYaw);
   int dx = (plX - camX) >> 8;
   int dy = (plY - camY) >> 8;
   int cz = (dx * fx + dy * fy) >> 8;
   int cxl = (dx * fy - dy * fx) >> 8;
   int cup = (plAlt - camAlt) << 6;
   int hz16 = (120 + camPitch) * 16;
   for (int i = 0; i < nVerts; i++)
   {
      int x = mvX[i];
      int y = mvY[i];
      int z = mvZ[i];
      if (mvPart[i] == 1)
      {
         int t = (x * cpr - y * spr) >> 8;
         y = (x * spr + y * cpr) >> 8;
         x = t;
      }
      // the bank: round z (right wing down when it turns right)
      int x1 = (x * cb + y * sb) >> 8;
      int y1 = (y * cb - x * sb) >> 8;
      // the climb: round x (nose up)
      int y2 = (y1 * cp + z * sp) >> 8;
      int z2 = (z * cp - y1 * sp) >> 8;
      // the heading: round y
      int x3 = (x1 * cy + z2 * sy) >> 8;
      int z3 = (z2 * cy - x1 * sy) >> 8;
      rvX[i] = x3;
      rvY[i] = y2;
      rvZ[i] = z3;
      // a unit is 0.6 of a cell: 128ths of a unit x 1.2 = cells x 256
      int X = cxl + ((x3 * 77) >> 6);
      int Y = cup + ((y2 * 77) >> 6);
      int Z = cz + ((z3 * 77) >> 6);
      if (Z < 256)
         Z = 256;
      cvX[i] = X;
      cvY[i] = Y;
      cvZ[i] = Z;
      int sx = HALFW * 16 + X * FOCAL * 16 / Z;
      svX[i] = sx;
      svY[i] = hz16 + ((((sx >> 4) - HALFW) * camBank) >> 4) - Y * FOCAL * 16 / Z;
   }
   // the sun, seen from the camera: across, up, ahead
   float lx = (-0.55 * fy + 0.56 * fx) / 256.0;
   float ly = 0.62;
   float lz = (-0.55 * fx - 0.56 * fy) / 256.0;
   float dayK = (lightPct + 40) / 140.0;
   // far to near: in 64 slices of depth round the plane's
   for (int b = 0; b < 64; b++)
      bucketHead[b] = -1;
   for (int t = 0; t < nTris; t++)
   {
      int a = mtA[t];
      int b2 = mtB[t];
      int c = mtC[t];
      int zm = (cvZ[a] + cvZ[b2] + cvZ[c]) / 3;
      int bk = clampi((zm - cz + 1024) >> 5, 0, 63);
      bucketNext[t] = bucketHead[bk];
      bucketHead[bk] = t;
   }
   int zq = imax(1, zqOf(cz) - 1);
   for (int b = 63; b >= 0; b--)
   {
      int t = bucketHead[b];
      while (t >= 0)
      {
         int a = mtA[t];
         int b2 = mtB[t];
         int c = mtC[t];
         if (iabs(svX[a] - HALFW * 16) < 6000 && iabs(svX[b2] - HALFW * 16) < 6000 && iabs(svX[c] - HALFW * 16) < 6000 &&
             iabs(svY[a]) < 9000 && iabs(svY[b2]) < 9000 && iabs(svY[c]) < 9000)
         {
            uint16_t cc = 0;
            int dith = 0;
            if (mtPart[t] == 2)
            {
               int v = (int)(225.0 * dayK);
               cc = col(v, v, v + 10);
               dith = 1;
            }
            else
            {
               // the triangle's normal, toward the camera
               float ux = rvX[b2] - rvX[a];
               float uy = rvY[b2] - rvY[a];
               float uz = rvZ[b2] - rvZ[a];
               float vx = rvX[c] - rvX[a];
               float vy = rvY[c] - rvY[a];
               float vz = rvZ[c] - rvZ[a];
               float nx = uy * vz - uz * vy;
               float ny = uz * vx - ux * vz;
               float nz = ux * vy - uy * vx;
               float facing = nx * cvX[a] + ny * cvY[a] + nz * cvZ[a];
               if (facing > 0.0)
               {
                  nx = -nx;
                  ny = -ny;
                  nz = -nz;
               }
               float len = hypot(hypot(nx, ny), nz);
               float k = 0.4;
               if (len > 0.0)
               {
                  float d = (nx * lx + ny * ly + nz * lz) / len;
                  if (d > 0.0)
                  {
                     k = 0.4 + 0.72 * d;
                     // a glint where it faces the sun
                     if (d > 0.88)
                        k = k + (d - 0.88) * 3.5;
                  }
               }
               k = k * dayK;
               cc = col((int)(mtR[t] * k), (int)(mtG[t] * k), (int)(mtBl[t] * k));
            }
            fillTri(svX[a], svY[a], svX[b2], svY[b2], svX[c], svY[c], cc, dith, zq);
         }
         t = bucketNext[t];
      }
   }
}

// ------------------------------------------------------------------ the minimap

#define MMR 30
int mmHalf[61];
int curRegion = -1;
int regionTimer;

char *regionName(int g)
{
   if (g == 0)
      return "THE HUNDRED ISLES";
   if (g == 1)
      return "THE RED CANYONS";
   if (g == 2)
      return "THE FROST PEAKS";
   if (g == 3)
      return "THE EMBER COAST";
   return "POSTHAVEN CITY";
}

void makeMinimap()
{
   for (int dy = -MMR; dy <= MMR; dy++)
   {
      int h = 0;
      while ((h + 1) * (h + 1) + dy * dy <= MMR * MMR)
         h++;
      mmHalf[dy + MMR] = h;
   }
}

// a point of the world on the minimap (cells): mmX, mmY, and 0 when it is
// past the rim (then it is put on the rim)
int mmX;
int mmY;

int miniPoint(int wx, int wy)
{
   int dx = wrapDiff(plX >> 16, wx);
   int dy = wrapDiff(plY >> 16, wy);
   int fx = isin8(plYaw);
   int fy = icos8(plYaw);
   // 3 cells a pixel; the plane's heading up
   int sx = (dx * fy - dy * fx) / 768;
   int sy = -(dx * fx + dy * fy) / 768;
   int in = 1;
   int r2 = sx * sx + sy * sy;
   if (r2 > (MMR - 3) * (MMR - 3))
   {
      float fsx = sx;
      float fsy = sy;
      float d = hypot(fsx, fsy);
      float k = (MMR - 3) / d;
      sx = (int)(sx * k);
      sy = (int)(sy * k);
      in = 0;
   }
   mmX = SW - MMR - 6 + sx;
   mmY = MMR + 20 + sy;
   return in;
}

// top right: the land round the plane, turning with it (its heading up),
// the next gate, the letters, north on the rim
void drawMinimap()
{
   int cx = SW - MMR - 6;
   int cy = MMR + 20;
   int fx = isin8(plYaw);
   int fy = icos8(plYaw);
   int px = plX >> 8;
   int py = plY >> 8;
   for (int dy = -MMR; dy <= MMR; dy++)
   {
      int h = mmHalf[dy + MMR];
      int y = cy + dy;
      int o = orgOff + y * stride;
      // world (cells x 256) at the row's left end, and the step right
      int wx = px + (fy * (-h) - fx * dy) * 3;
      int wy = py + (-fx * (-h) - fy * dy) * 3;
      int sx = fy * 3;
      int sy = -fx * 3;
      for (int x = cx - h; x <= cx + h; x++)
      {
         display[o + x] = miniCol[(((wy >> 11) & 127) << 7) + ((wx >> 11) & 127)];
         wx = wx + sx;
         wy = wy + sy;
      }
   }
   // the rim
   uint16_t rim = col(230, 220, 190);
   for (int a = 0; a < 1024; a = a + 8)
   {
      int x = cx + ((isin8(a) * MMR) >> 8);
      int y = cy + ((icos8(a) * MMR) >> 8);
      display[orgOff + y * stride + x] = rim;
      display[orgOff + y * stride + x + 1] = rim;
   }
   // letters: white dots; the next gate: yellow, on the rim when far
   for (int i = 0; i < nLetters; i++)
      if (letterGot[i] == 0 && miniPoint(letterX[i], letterY[i]) == 1)
         display[orgOff + mmY * stride + mmX] = col(255, 255, 255);
   if (nextGate < nGates)
   {
      miniPoint(gateX[nextGate], gateY[nextGate]);
      uint16_t gc = col(255, 220, 60);
      if ((frameNo & 8) == 0)
         gc = col(255, 140, 30);
      for (int k = -1; k <= 1; k++)
      {
         display[orgOff + (mmY + k) * stride + mmX - 1] = gc;
         display[orgOff + (mmY + k) * stride + mmX] = gc;
         display[orgOff + (mmY + k) * stride + mmX + 1] = gc;
      }
   }
   // north (the map's -y... +y is the compass's N)
   int nx = cx - ((fx * MMR) >> 8);
   int ny = cy - ((fy * MMR) >> 8);
   fillRect(nx - 4, ny - 4, 9, 9, col(30, 30, 50));
   setInk(col(255, 240, 160), col(30, 30, 50), 1);
   drawText("N", nx - 2, ny - 3);
   // the plane, pointing up
   uint16_t pc = col(255, 60, 40);
   uint16_t wc = col(255, 255, 255);
   fillRect(cx, cy - 3, 1, 7, pc);
   fillRect(cx - 3, cy - 1, 7, 1, wc);
   fillRect(cx - 1, cy + 3, 3, 1, wc);
}

// the region's name, when the plane flies into another
void drawRegion()
{
   int g = rmap[(((plY >> 19) & 127) << 7) + ((plX >> 19) & 127)];
   if (g != curRegion)
   {
      curRegion = g;
      regionTimer = 75;
   }
   if (regionTimer <= 0)
      return;
   regionTimer--;
   setInk(col(255, 240, 200), col(20, 10, 10), 2);
   centreText(regionName(g), 50);
}

// the altimeter, on the left: the sea, the ground under the plane, the
// plane; the altitude in metres; PULL UP when the ground ahead is near
void drawAltimeter()
{
   int x0 = 6;
   int y0 = 48;
   int hgt = 150;
   int sea = SEA << 1;
   fillRect(x0, y0, 6, hgt, col(20, 24, 44));
   int g = imax(groundAt(plX >> 16, plY >> 16), sea);
   int gy = y0 + hgt - (g - sea) * hgt / (600 - sea);
   fillRect(x0, gy, 6, y0 + hgt - gy, col(150, 110, 60));
   fillRect(x0 - 2, y0 + hgt, 10, 1, col(80, 160, 255));
   int py = y0 + hgt - imax(0, plAlt - sea) * hgt / (600 - sea);
   fillRect(x0 - 3, py - 1, 12, 3, col(255, 220, 60));
   setInk(col(220, 240, 255), col(10, 10, 30), 1);
   int x = drawNum(imax(0, (plAlt - sea) * 5 / 2), 1, x0 + 10, py - 4);
   drawText("m", x + 1, py - 4);
   if (crashed > 0)
      return;
   // the highest ground over the next 10 cells
   int fx = isin8(plYaw);
   int fy = icos8(plYaw);
   int ahead = 0;
   for (int k = 0; k <= 10; k = k + 2)
      ahead = imax(ahead, groundAt((plX >> 16) + ((fx * k) >> 8), (plY >> 16) + ((fy * k) >> 8)));
   if (plAlt - ahead < 18 && (frameNo & 4) == 0)
   {
      setInk(col(255, 60, 40), col(40, 0, 0), 2);
      centreText("PULL UP", 150);
   }
}

// ------------------------------------------------------------------ the HUD

// a compass across the top: the plane's heading, N E S W every quarter
void drawCompass()
{
   fillRect(HALFW - 60, 18, 120, 1, col(200, 210, 240));
   for (int k = 0; k < 16; k++)
   {
      int a = k * 64;
      int d = angleDiff(plYaw, a);
      if (d < -110 || d > 110)
         continue;
      int x = HALFW + d * 60 / 110;
      if ((k & 3) == 0)
      {
         char *n = "N";
         if (k == 4)
            n = "E";
         if (k == 8)
            n = "S";
         if (k == 12)
            n = "W";
         setInk(col(255, 240, 160), col(10, 10, 30), 1);
         drawText(n, x - 2, 21);
         fillRect(x, 16, 1, 5, col(255, 240, 160));
      }
      else
         fillRect(x, 17, 1, 3, col(200, 210, 240));
   }
   fillRect(HALFW, 14, 1, 7, col(255, 90, 60));
}

void drawHud()
{
   dimRect(0, 0, SW, 15, col(6, 10, 30));
   // the camera's view, a moment after C, U or J
   if (camMsg > 0)
   {
      camMsg--;
      setInk(col(200, 240, 255), col(10, 10, 30), 1);
      centreText(viewName(camView), 196);
      if (camTilt != 0)
      {
         int x = drawText("tilt ", 176, 208);
         drawNum(camTilt / 8, 1, x, 208);
      }
   }
   setInk(col(255, 255, 255), col(10, 10, 30), 1);
   if (freeFlight == 1)
   {
      // free flight: the time of day, the letters, a compass
      int x = drawText("FREE FLIGHT - ", 4, 4);
      setInk(col(255, 230, 140), col(10, 10, 30), 1);
      x = drawText(skyName(freeSky), x, 4);
      setInk(col(255, 240, 200), col(10, 10, 30), 1);
      x = drawText("   LETTERS ", x, 4);
      drawNum(lettersGot, 1, x, 4);
      setInk(col(200, 210, 240), col(10, 10, 30), 1);
      drawText("T: time of day", SW - 4 - textWidth("T: time of day"), 4);
      drawCompass();
      fillRect(4, SH - 10, 62, 6, col(20, 20, 40));
      fillRect(5, SH - 9, boost * 60 / 1000, 4, col(80, 220, 255));
      setInk(col(220, 240, 255), col(10, 10, 30), 1);
      drawAltimeter();
      drawMinimap();
      setInk(col(220, 240, 255), col(10, 10, 30), 1);
      x = drawText("SPEED ", 74, SH - 12);
      drawNum(plSpeed / 300, 1, x, SH - 12);
      drawRegion();
      if (showMs == 1)
      {
         setInk(col(160, 255, 160), col(10, 10, 30), 1);
         x = drawNum(msFrame, 1, 4, 20);
         drawText("ms", x + 2, 20);
      }
      if (crashed > 0)
      {
         setInk(col(255, 120, 80), col(30, 0, 0), 2);
         centreText("CRASH!", 90);
      }
      return;
   }
   int x = drawText("GATE ", 4, 4);
   x = drawNum(imin(nextGate + 1, nGates), 1, x, 4);
   x = drawText("/", x, 4);
   x = drawNum(nGates, 1, x, 4);
   setInk(col(255, 240, 200), col(10, 10, 30), 1);
   x = drawText("  LETTERS ", x, 4);
   x = drawNum(lettersGot, 1, x, 4);
   // the time, big, red when short
   int secs = imax(0, timeLeft / 30);
   uint16_t tc = col(255, 255, 255);
   if (secs < 10)
      tc = col(255, 80, 60);
   setInk(tc, col(10, 10, 30), 2);
   drawNum(secs, 2, 186, 1);
   setInk(col(255, 255, 255), col(10, 10, 30), 1);
   char *sc = numText(score, 6);
   drawText(sc, SW - 4 - textWidth(sc), 4);
   // the boost gauge and the altitude
   fillRect(4, SH - 10, 62, 6, col(20, 20, 40));
   fillRect(5, SH - 9, boost * 60 / 1000, 4, col(80, 220, 255));
   setInk(col(220, 240, 255), col(10, 10, 30), 1);
   drawAltimeter();
   drawMinimap();
   drawRegion();
   // the way to the next gate, when it is off the screen
   if (nextGate < nGates && crashed == 0)
   {
      int d = angleDiff(plYaw, iangle(wrapDiff(plX >> 16, gateX[nextGate]), wrapDiff(plY >> 16, gateY[nextGate])));
      if (d < -120 || d > 120)
      {
         int ax = HALFW + 70;
         int dir = 1;
         if (d < 0)
         {
            ax = HALFW - 70;
            dir = -1;
         }
         for (int k = 0; k < 7; k++)
            fillRect(ax + dir * k, 30 - k + 6, 2, k * 2 + 1 - 6 + 6, col(255, 220, 80));
      }
   }
   if (showMs == 1)
   {
      setInk(col(160, 255, 160), col(10, 10, 30), 1);
      x = drawNum(msFrame, 1, 4, 20);
      drawText("ms", x + 2, 20);
   }
   if (crashed > 0)
   {
      setInk(col(255, 120, 80), col(30, 0, 0), 2);
      centreText("CRASH!", 90);
   }
}

// ------------------------------------------------------------------ keys

// the autopilot: turn toward the next gate, climb or dive to its height,
// and climb over what is ahead
void steerToGate()
{
   int g = nextGate;
   int d = angleDiff(plYaw, iangle(wrapDiff(plX >> 16, gateX[g]), wrapDiff(plY >> 16, gateY[g])));
   kLeft = 0;
   kRight = 0;
   if (d < -6)
      kLeft = 1;
   if (d > 6)
      kRight = 1;
   int want = gateAlt[g];
   int fx = isin8(plYaw);
   int fy = icos8(plYaw);
   for (int k = 0; k <= 30; k = k + 2)
   {
      int gh = groundAt((plX >> 16) + ((fx * k) >> 8), (plY >> 16) + ((fy * k) >> 8)) + 30;
      if (gh > want)
         want = gh;
   }
   kUp = 0;
   kDown = 0;
   // where the climb it has will take it before it can change it
   int coming = plAlt + plClimb * iabs(plClimb) / 4;
   if (coming < want - 4)
      kUp = 1;
   if (coming > want + 6)
      kDown = 1;
}

int getKey()
{
   int k = readKey();
   if (k == 10)
      k = 13;
   return k;
}

int held(int a, int b)
{
   if (keyHeld(a) == 1)
      return 1;
   if (b != 0 && keyHeld(b) == 1)
      return 1;
   return 0;
}

void readKeys()
{
   menuKey = 0;
   int k = getKey();
   while (k != 0)
   {
      if (k == KEY_ENTER || k == KEY_ESC)
         menuKey = k;
      else if (k == KEY_P)
         showMs = 1 - showMs;
      else if (k == KEY_M)
         setMode(3 - pixelMode);
      else if (k == KEY_O)
         autoPilot = 1 - autoPilot;
      else if (k == KEY_C)
      {
         camView = (camView + 1) & 3;
         camTilt = 0;
         camMsg = 45;
      }
      else if (k == KEY_U)
      {
         camTilt = imin(64, camTilt + 8);
         camMsg = 45;
      }
      else if (k == KEY_J)
      {
         camTilt = imax(-64, camTilt - 8);
         camMsg = 45;
      }
      else if (k == KEY_T && freeFlight == 1)
      {
         // the next time of day: the sky, the haze, the light
         freeSky = (freeSky + 1) & 3;
         changeSky(freeSky);
      }
      k = getKey();
   }
   kUp = held(KEY_UP, KEY_W);
   kDown = held(KEY_DOWN, 0);
   kLeft = held(KEY_LEFT, KEY_A);
   kRight = held(KEY_RIGHT, 0);
   kBoost = held(KEY_SPACE, KEY_K);
   if (autoPilot == 1 && nextGate < nGates)
      steerToGate();
}

int waitKey()
{
   while (true)
   {
      int k = getKey();
      if (k == KEY_ENTER || k == KEY_SPACE)
         return 1;
      if (k == KEY_ESC)
         return 0;
      delay(15);
   }
   return 0;
}

