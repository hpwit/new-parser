{
   for (int k = 0; k < 40; k++)
   {
      renderWorld();
      dimRect(60, 60, 280, 120, col(6, 10, 30));
      if (won == 1)
      {
         setInk(col(255, 230, 90), col(40, 20, 0), 2);
         centreText("ROUTE FLOWN!", 72);
      }
      else
      {
         setInk(col(255, 120, 90), col(40, 0, 0), 2);
         centreText("THE MAIL IS LATE", 72);
      }
      setInk(col(240, 240, 255), col(0, 0, 0), 1);
      int x = drawText("gates ", 110, 108);
      x = drawNum(gatesDone, 1, x, 108);
      x = drawText("/", x, 108);
      x = drawNum(nGates, 1, x, 108);
      x = drawText("   letters ", x, 108);
      x = drawNum(lettersGot, 1, x, 108);
      x = drawText("/", x, 108);
      drawNum(nLetters, 1, x, 108);
      x = drawText("score ", 150, 128);
      drawNum(score, 1, x, 128);
      if (won == 1)
      {
         x = drawText("time left ", 140, 146);
         x = drawNum(timeLeft / 30, 1, x, 146);
         drawText(" s", x, 146);
      }
      centreText("Enter", 166);
      updateDisplay();
      delay(30);
   }
   waitKey();
}

// one route: 1 flown, 0 out of time, -1 left
int fly(int n)
{
   freeFlight = 0;
   if (n == 5)
   {
      // free flight: the first route's isles and letters, no gates, no
      // clock
      freeFlight = 1;
      loadRoute(0);
      changeSky(freeSky);
      startRoute();
      nGates = 0;
   }
   else
   {
      loadRoute(n);
      routeCard();
      startRoute();
   }
   score = 0;
   updateCamera();
   uint32_t last = millis();
   while (true)
   {
      readKeys();
      if (menuKey == KEY_ESC)
      {
         renderWorld();
         dimRect(60, 84, 280, 56, col(0, 0, 0));
         setInk(col(255, 255, 255), col(0, 0, 0), 1);
         if (freeFlight == 1)
            centreText("Land and leave? Y / N", 106);
         else
            centreText("Leave this route? Y / N", 106);
         updateDisplay();
         while (true)
         {
            int k = getKey();
            if (k == KEY_Y)
               return -1;
            if (k == KEY_N || k == KEY_ESC || k == KEY_ENTER)
               break;
            delay(15);
         }
         last = millis();
      }
      if (menuKey == KEY_ENTER)
      {
         setInk(col(255, 255, 255), col(0, 0, 0), 3);
         centreText("PAUSED", 100);
         updateDisplay();
         waitKey();
         last = millis();
      }
      uint32_t now = millis();
      int steps = (now - last) / 33;
      if (steps < 1)
      {
         delay(33 - (now - last));
         continue;
      }
      if (steps > 3)
      {
         steps = 3;
         last = now;
      }
      else
         last = last + steps * 33;
      for (int s = 0; s < steps; s++)
      {
         updatePlane();
         touches();
         updateSparks();
         trails();
         if (crashed == 0 && freeFlight == 0)
            timeLeft--;
         stepNo++;
      }
      updateCamera();
      uint32_t t1 = millis();
      renderWorld();
      drawShadow();
      drawPlane();
      drawHud();
      updateDisplay();
      msFrame = millis() - t1;
      if (freeFlight == 1)
         continue;
      if (routeDone == 1)
      {
         score = score + (timeLeft / 30) * 50;
         results(1);
         return 1;
      }
      if (timeLeft <= 0)
      {
         results(0);
         return 0;
      }
   }
   return -1;
}

int main()
{
   if (wadLoaded == 0)
   {
      printfln("driftwing.wad must be next to the script");
      return 1;
   }
   enableGraphicMode();
   setMode(2);
   fontOff = wadFind("FONT");
   textOff = wadFind("TEXT");
   routesOff = wadFind("ROUTES");
   clearScreen(col(0, 0, 0));
   setInk(col(255, 200, 120), col(0, 0, 0), 1);
   centreText("unfolding the map...", 116);
   updateDisplay();
   makeSines();
   makeDither();
   loadMap();
   sprFill = 0;
   loadSprite("BALLOON", S_BALLOON);
   loadSprite("BIRD", S_BIRD);
   loadSprite("LETTER", S_LETTER);
   makeClouds();
   loadMesh();
   loadCity();
   loadMinimap();
   makeMinimap();
   if (argc > 0 && arg(0) == 1)
   {
      modeChoice = 1;
      menuRow = 0;
   }
   int seen = 0;
   while (true)
   {
      if (title() == 0)
         return 0;
      if (seen == 0 && menuChoice < 5)
      {
         story(STORY_INTRO);
         seen = 1;
      }
      int r = fly(menuChoice);
      if (menuChoice == 5)
         continue;
      if (r == 1 && menuChoice == NROUTES - 1)
         story(STORY_END);
      if (r == 1 && menuChoice < NROUTES - 1)
      {
         menuChoice++;
         menuRow = menuChoice;
      }
   }
   return 0;
}
