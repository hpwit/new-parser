// ------------------------------------------------------------------ memory

uint8_t ubuf[20000];
uint8_t hmap[1048576];
uint8_t cmap[1048576];
uint8_t palR[256];
uint8_t palG[256];
uint8_t palB[256];
// the ground's colours at 32 distances (the last: the haze's colour)
uint16_t shade[8192];
// the same, darker: the sides of cliffs, trees and roofs
uint16_t shadeD[8192];
// per screen column: the highest row drawn so far (nearer ground covers)
int ybuf[SW];
// per screen column: the height of the ground a step nearer
int prevH[SW];
// per screen column: the horizon's row (banking tilts it)
int hzc[SW];
// per pixel: how far the ground there is (0 near .. 254 far, 255 sky)
uint8_t zdep[96000];
uint16_t skyCol[720];

// sprites: the plane's 15 frames, the balloon, the bird, the letter
uint16_t sprPix[4000];
int sprOff[4];
int sprW[4];
int sprH[4];
int sprN[4];
int sprFill;
#define S_BALLOON 1
#define S_BIRD 2
#define S_LETTER 3

int fontOff;
int textOff;
int routesOff;
int orgOff;
int frameNo;
int pixelMode = 2;

// ------------------------------------------------------------------ helpers

int iabs(int v)
{
   if (v < 0)
      return -v;
   return v;
}

int imin(int a, int b)
{
   if (a < b)
      return a;
   return b;
}

int imax(int a, int b)
{
   if (a > b)
      return a;
   return b;
}

int clampi(int v, int lo, int hi)
{
   if (v < lo)
      return lo;
   if (v > hi)
      return hi;
   return v;
}

int rnd(int n)
{
   if (n <= 1)
      return 0;
   return rand(n);
}

uint16_t col(int r, int g, int b)
{
   r = clampi(r, 0, 255);
   g = clampi(g, 0, 255);
   b = clampi(b, 0, 255);
   int v = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
   return ((v & 255) << 8) | (v >> 8);
}

int mixc(int a, int b, int k)
{
   return a + (((b - a) * k) >> 8);
}

// sines: 1024 to a turn, 256 = 1.0 (isin8) for the map's fixed point
int sin8[1024];

void makeSines()
{
   for (int i = 0; i < 1024; i++)
   {
      float a = i * 0.00613592315;
      float s = sin(a);
      sin8[i] = (int)(s * 256.0);
   }
}

int isin8(int a)
{
   return sin8[a & 1023];
}

int icos8(int a)
{
   return sin8[(a + 256) & 1023];
}

int iangle(int x, int y)
{
   float fx = x;
   float fy = y;
   float a = atan2(fx, fy);
   int r = (int)(a * 162.974661);
   return r & 1023;
}

int angleDiff(int a, int b)
{
   int d = (b - a) & 1023;
   if (d >= 512)
      d = d - 1024;
   return d;
}

// the shortest way across the wrapping map, from a to b (cells)
int wrapDiff(int a, int b)
{
   int d = (b - a) & (MAPN - 1);
   if (d >= MAPN / 2)
      d = d - MAPN;
   return d;
}

// ------------------------------------------------------------------ the WAD

int rd16(int o)
{
   return ubuf[o] | (ubuf[o + 1] << 8);
}

int wd16(int o)
{
   return wad[o] | (wad[o + 1] << 8);
}

// a compressed lump into ubuf (into: 0), hmap (1) or cmap (2)
int unpackTo(char *name, int into)
{
   int off = wadFind(name);
   if (off < 0)
      return 0;
   int n = wad[off] | (wad[off + 1] << 8) | (wad[off + 2] << 16) | (wad[off + 3] << 24);
   int i = off + 4;
   int o = 0;
   while (o < n)
   {
      int t = wad[i];
      i++;
      if (t < 128)
      {
         int cnt = t + 1;
         if (into == 1)
            for (int k = 0; k < cnt; k++)
               hmap[o + k] = wad[i + k];
         else if (into == 2)
            for (int k = 0; k < cnt; k++)
               cmap[o + k] = wad[i + k];
         else
            for (int k = 0; k < cnt; k++)
               ubuf[o + k] = wad[i + k];
         i = i + cnt;
         o = o + cnt;
      }
      else
      {
         int ln = (t & 127) + 3;
         int d = wad[i] | (wad[i + 1] << 8);
         i = i + 2;
         if (into == 1)
            for (int k = 0; k < ln; k++)
               hmap[o + k] = hmap[o + k - d];
         else if (into == 2)
            for (int k = 0; k < ln; k++)
               cmap[o + k] = cmap[o + k - d];
         else
            for (int k = 0; k < ln; k++)
               ubuf[o + k] = ubuf[o + k - d];
         o = o + ln;
      }
   }
   return n;
}

int unpack(char *name)
{
   return unpackTo(name, 0);
}

void loadMap()
{
   unpackTo("HMAP", 1);
   unpackTo("CMAP", 2);
   int p = wadFind("PAL");
   for (int i = 0; i < 256; i++)
   {
      palR[i] = wad[p + i * 3];
      palG[i] = wad[p + i * 3 + 1];
      palB[i] = wad[p + i * 3 + 2];
   }
}

// the minimap: a colour every 8 cells; the regions the same
uint16_t miniCol[16384];
uint8_t rmap[16384];

void loadMinimap()
{
   unpack("MINI");
   for (int i = 0; i < 16384; i++)
   {
      int c = ubuf[i];
      miniCol[i] = col(palR[c], palG[c], palB[c]);
   }
   unpack("RMAP");
   for (int i = 0; i < 16384; i++)
      rmap[i] = ubuf[i];
}

uint16_t lumpPal[256];

void loadSprite(char *name, int id)
{
   unpack(name);
   int w = rd16(0);
   int h = rd16(2);
   int nf = rd16(4);
   int nc = rd16(6);
   for (int i = 0; i < nc; i++)
      lumpPal[i] = rd16(16 + i * 2);
   int p = 16 + nc * 2;
   int n = w * h * nf;
   sprOff[id] = sprFill;
   sprW[id] = w;
   sprH[id] = h;
   sprN[id] = nf;
   for (int i = 0; i < n; i++)
      sprPix[sprFill + i] = lumpPal[ubuf[p + i]];
   sprFill = sprFill + n;
}

// ------------------------------------------------------------------ text

uint16_t inkCol;
uint16_t shadowCol;
int textScale;

void setInk(uint16_t ink, uint16_t shadow, int scale)
{
   inkCol = ink;
   shadowCol = shadow;
   textScale = scale;
}

int glyphW(int c)
{
   if (c < 32 || c > 126)
      return 0;
   return wad[fontOff + c - 32] * textScale;
}

int textWidth(char *s)
{
   int w = 0;
   int i = 0;
   while (s[i] != 0)
   {
      int c = s[i];
      w = w + glyphW(c);
      i++;
   }
   return w;
}

void plotGlyph(int c, int x, int y, uint16_t ink)
{
   int g = fontOff + 95 + (c - 32) * 8;
   int sc = textScale;
   for (int r = 0; r < 8; r++)
   {
      int bits = wad[g + r];
      if (bits == 0)
         continue;
      for (int i = 0; i < 8; i++)
      {
         if (((bits << i) & 128) == 0)
            continue;
         for (int sy2 = 0; sy2 < sc; sy2++)
         {
            int yy = y + r * sc + sy2;
            if (yy < 0 || yy >= SH)
               continue;
            int o = orgOff + yy * stride;
            for (int sx2 = 0; sx2 < sc; sx2++)
            {
               int xx = x + i * sc + sx2;
               if (xx >= 0 && xx < SW)
                  display[o + xx] = ink;
            }
         }
      }
   }
}

int drawChar(int c, int x, int y)
{
   if (c < 32 || c > 126)
      return x;
   plotGlyph(c, x + textScale, y + textScale, shadowCol);
   plotGlyph(c, x, y, inkCol);
   return x + glyphW(c);
}

int drawText(char *s, int x, int y)
{
   int i = 0;
   while (s[i] != 0)
   {
      int c = s[i];
      x = drawChar(c, x, y);
      i++;
   }
   return x;
}

void centreText(char *s, int y)
{
   drawText(s, (SW - textWidth(s)) / 2, y);
}

char numBuf[16];
char numTmp[16];

char *numText(int v, int digits)
{
   int neg = 0;
   if (v < 0)
   {
      neg = 1;
      v = -v;
   }
   int n = 0;
   while (v > 0 || n < digits || n == 0)
   {
      numTmp[n] = 48 + v % 10;
      v = v / 10;
      n++;
      if (n >= 11)
         break;
   }
   int i = 0;
   if (neg == 1)
   {
      numBuf[0] = 45;
      i = 1;
   }
   for (int k = n - 1; k >= 0; k--)
   {
      numBuf[i] = numTmp[k];
      i++;
   }
   numBuf[i] = 0;
   return numBuf;
}

int drawNum(int v, int digits, int x, int y)
{
   return drawText(numText(v, digits), x, y);
}

int drawStoryPage(int off, int x, int y, int maxw, int lineH)
{
   int cx = x;
   int cy = y;
   int i = off;
   while (true)
   {
      int c = wad[textOff + i];
      if (c == 0)
         return -1;
      if (c == 124)
         return i + 1;
      if (c == 32)
      {
         int w = glyphW(32);
         int k = i + 1;
         int c2 = wad[textOff + k];
         while (c2 != 0 && c2 != 32 && c2 != 124)
         {
            w = w + glyphW(c2);
            k++;
            c2 = wad[textOff + k];
         }
         if (cx + w > x + maxw)
         {
            cx = x;
            cy = cy + lineH;
         }
         else
            cx = drawChar(32, cx, cy);
         i++;
         continue;
      }
      cx = drawChar(c, cx, cy);
      i++;
   }
   return -1;
}

void fillRect(int x, int y, int w, int h, uint16_t c)
{
   int x0 = imax(0, x);
   int y0 = imax(0, y);
   int x1 = imin(SW, x + w);
   int y1 = imin(SH, y + h);
   for (int yy = y0; yy < y1; yy++)
   {
      int o = orgOff + yy * stride;
      for (int xx = x0; xx < x1; xx++)
         display[o + xx] = c;
   }
}

void dimRect(int x, int y, int w, int h, uint16_t c)
{
   int x0 = imax(0, x);
   int y0 = imax(0, y);
   int x1 = imin(SW, x + w);
   int y1 = imin(SH, y + h);
   for (int yy = y0; yy < y1; yy++)
   {
      int o = orgOff + yy * stride;
      for (int xx = x0 + ((x0 + yy) & 1); xx < x1; xx = xx + 2)
         display[o + xx] = c;
   }
}

void clearScreen(uint16_t c)
{
   fillRect(0, 0, SW, SH, c);
}

// ------------------------------------------------------------------ the screen's mode

void blankPanel()
{
   uint16_t black = col(0, 0, 0);
   for (int k = 0; k < 2; k++)
   {
      for (int i = 0; i < 480 * stride; i++)
         display[i] = black;
      updateDisplay();
   }
}

void setMode(int mode)
{
   pixelMode = mode;
   setPixelsize(mode);
   if (mode == 1)
      orgOff = 120 * stride + 200;
   else
      orgOff = 0;
   blankPanel();
}

// ------------------------------------------------------------------ the route's look

int skyTopR;
int skyTopG;
int skyTopB;
int skyBotR;
int skyBotG;
int skyBotB;
int fogR;
int fogG;
int fogB;
int lightPct;

// the ground's colours at 32 distances: lit by the route's light, then
// faded toward the haze (the last level is all haze)
void makeShades()
{
   for (int f = 0; f < 32; f++)
   {
      int k = f * f * 256 / 961;
      for (int c = 0; c < 256; c++)
      {
         int r = palR[c] * lightPct / 100;
         int g = palG[c] * lightPct / 100;
         int b = palB[c] * lightPct / 100;
         shade[f * 256 + c] = col(mixc(r, fogR, k), mixc(g, fogG, k), mixc(b, fogB, k));
         shadeD[f * 256 + c] = col(mixc(r * 7 / 10, fogR, k), mixc(g * 7 / 10, fogG, k), mixc(b * 7 / 10, fogB, k));
      }
   }
   // the sky by how far above the horizon: 0 at the horizon (the haze),
   // the top colour high up; below the horizon the haze stays
   for (int d = 0; d < 720; d++)
   {
      int up = d - 360;
      if (up < 0)
         up = 0;
      int k = imin(256, up * 256 / 200);
      int r = mixc(skyBotR, skyTopR, k);
      int g = mixc(skyBotG, skyTopG, k);
      int b = mixc(skyBotB, skyTopB, k);
      if (up < 20)
      {
         r = mixc(fogR, r, up * 256 / 20);
         g = mixc(fogG, g, up * 256 / 20);
         b = mixc(fogB, b, up * 256 / 20);
      }
      skyCol[d] = col(r, g, b);
   }
}

// ------------------------------------------------------------------ the camera

int camX;      // the map position, 16.16 cells
int camY;
int camAlt;    // the altitude, in quarters of a cell
int camYaw;    // 1024 a turn; 0 toward +y of the map
int camPitch;  // the horizon's offset, pixels
int camBank;   // the horizon's tilt, 1/256 pixel a column

// the ground's height under a map cell, in quarters of a cell (the map's
// bytes are half a cell each: the mountains are not too steep)
int groundAt(int x, int y)
{
   return hmap[((y & 1023) << 10) + (x & 1023)] << 1;
}

// a 4x4 ordered dither: where the near ground's colours change cell
int dith[16];

void makeDither()
{
   // Bayer's: the bits of x^y and y, interleaved and reversed
   for (int i = 0; i < 16; i++)
   {
      int x = i & 3;
      int y = i >> 2;
      int e = x ^ y;
      int v = ((e & 1) << 3) | ((y & 1) << 2) | (e & 2) | ((y >> 1) & 1);
      dith[i] = v * 16 + 8;
   }
}

// the landscape, near to far, column by column
void drawTerrain()
{
   for (int x = 0; x < SW; x++)
   {
      ybuf[x] = SH;
      prevH[x] = 1000;
      hzc[x] = 120 + camPitch + (((x - HALFW) * camBank) >> 8);
   }
   int fx = isin8(camYaw);
   int fy = icos8(camYaw);
   int rx = fy;
   int ry = -fx;
   int z = 256;
   int dz = 90;
   int fog = 0;
   int rowNo = 0;
   while (z < FAR * 256)
   {
      // the line across the map at this distance: its left end and the
      // step from a column to the next (16.16 cells)
      int half = z * HALFW / FOCAL;
      int pxl = camX + fx * z - rx * half;
      int pyl = camY + fy * z - ry * half;
      int dpx = rx * z / FOCAL;
      int dpy = ry * z / FOCAL;
      int invz = (FOCAL << 16) / z;
      fog = (z * 31) / (FAR * 256);
      int sb = fog << 8;
      int zq = 1 + (z * 253) / (FAR * 256);
      int nearRow = 0;
      if (z < NEAR * 256)
         nearRow = 1;
      rowNo++;
      for (int x = 0; x < SW; x++)
      {
         int cell = (((pyl >> 16) & 1023) << 10) + ((pxl >> 16) & 1023);
         int hq = hmap[cell] << 1;
         if (nearRow == 1)
         {
            // near: the height between the 4 cells round the point (no
            // blocks), the colour of one of them, dithered by how close
            int ax = (pxl >> 8) & 255;
            int ay = (pyl >> 8) & 255;
            int cx1 = (cell & 0xFFC00) + ((cell + 1) & 1023);
            int cy1 = (cell + 1024) & 1048575;
            int cxy = (cx1 + 1024) & 1048575;
            int h0 = (hmap[cell] << 8) + (hmap[cx1] - hmap[cell]) * ax;
            int h1 = (hmap[cy1] << 8) + (hmap[cxy] - hmap[cy1]) * ax;
            hq = ((h0 << 8) + (h1 - h0) * ay) >> 15;
            int thr = dith[((rowNo & 3) << 2) + (x & 3)];
            if (ax > thr)
               cell = cx1;
            if (ay > thr)
               cell = (cell + 1024) & 1048575;
         }
         int top = hzc[x] + (((camAlt - hq) * invz) >> 10);
         int side = ((hq - prevH[x]) * invz) >> 10;
         prevH[x] = hq;
         int yb = ybuf[x];
         if (top < yb)
         {
            if (top < 0)
               top = 0;
            // the top of the ground, then its side (a cliff, a roof's
            // edge), darker: as tall as the rise from the cell nearer
            int k = sb + cmap[cell];
            uint16_t c = shade[k];
            int split = yb - side;
            if (split < top)
               split = top;
            int o = orgOff + top * stride + x;
            int zi = top * SW + x;
            for (int y = top; y < yb; y++)
            {
               if (y == split)
                  c = shadeD[k];
               display[o] = c;
               zdep[zi] = zq;
               o = o + stride;
               zi = zi + SW;
            }
            ybuf[x] = top;
         }
         pxl = pxl + dpx;
         pyl = pyl + dpy;
      }
      z = z + dz;
      dz = dz + ((dz * 3) >> 8) + 1;
   }
   // the sky above what was drawn, by how far above the horizon
   for (int x = 0; x < SW; x++)
   {
      int yb = ybuf[x];
      int h = hzc[x];
      int o = orgOff + x;
      int zi = x;
      for (int y = 0; y < yb; y++)
      {
         int d = h - y + 360;
         if (d < 0)
            d = 0;
         if (d > 719)
            d = 719;
         display[o] = skyCol[d];
         zdep[zi] = 255;
         o = o + stride;
         zi = zi + SW;
      }
   }
}

// a point of the world on the screen (its map position in 16ths of a
// cell): sets projX, projY, projZ (cells x 256) and projScale (256 at 16
// cells away); returns 0 when it is behind or too far
int projX;
int projY;
int projZ;
int projScale;

int projectF(int wx16, int wy16, int walt4)
{
   // the map's offsets, the short way round
   int m = MAPN * 16;
   int dx = (wx16 - (camX >> 12)) & (m - 1);
   if (dx >= m / 2)
      dx = dx - m;
   int dy = (wy16 - (camY >> 12)) & (m - 1);
   if (dy >= m / 2)
      dy = dy - m;
   int fx = isin8(camYaw);
   int fy = icos8(camYaw);
   int z = (dx * fx + dy * fy) >> 4;
   if (z < 200 || z > FAR * 256)
      return 0;
   int x = (dx * fy - dy * fx) >> 4;
   projZ = z;
   projX = HALFW + x * FOCAL / z;
   if (projX < -80 || projX > SW + 80)
      return 0;
   int invz = (FOCAL << 16) / z;
   int h = 120 + camPitch + (((projX - HALFW) * camBank) >> 8);
   projY = h + (((camAlt - walt4) * invz) >> 10);
   projScale = 1048576 / z;
   return 1;
}

int project(int wx, int wy, int walt4)
{
   return projectF(wx << 4, wy << 4, walt4);
}

int zqOf(int z)
{
   return 1 + (z * 253) / (FAR * 256);
}

// a square dot at the screen point, hidden by nearer ground
void dot(int x, int y, int size, int zq, uint16_t c)
{
   for (int dy = 0; dy < size; dy++)
   {
      int yy = y - size / 2 + dy;
      if (yy < 0 || yy >= SH)
         continue;
      for (int dx = 0; dx < size; dx++)
      {
         int xx = x - size / 2 + dx;
         if (xx < 0 || xx >= SW)
            continue;
         if (zq < zdep[yy * SW + xx])
            display[orgOff + yy * stride + xx] = c;
      }
   }
}

// a sprite's frame scaled (k: 256 its size), its middle bottom at (x, y),
// hidden by nearer ground
void drawSpriteScaled(int id, int frame, int x, int y, int k, int zq)
{
   int w = sprW[id];
   int h = sprH[id];
   int dw = (w * k) >> 8;
   int dh = (h * k) >> 8;
   if (dw < 1 || dh < 1)
      return;
   int src = sprOff[id] + frame * w * h;
   int x0 = x - dw / 2;
   int y0 = y - dh;
   for (int j = 0; j < dh; j++)
   {
      int yy = y0 + j;
      if (yy < 0 || yy >= SH)
         continue;
      int sy = (j * h) / dh;
      int o = orgOff + yy * stride;
      for (int i = 0; i < dw; i++)
      {
         int xx = x0 + i;
         if (xx < 0 || xx >= SW)
            continue;
         if (zq >= zdep[yy * SW + xx])
            continue;
         uint16_t c = sprPix[src + sy * w + (i * w) / dw];
         if (c != KEY)
            display[o + xx] = c;
      }
   }
}

// a sprite at its own size, its top left at (x, y)
void drawSprite(int id, int frame, int x, int y)
{
   int w = sprW[id];
   int h = sprH[id];
   int src = sprOff[id] + frame * w * h;
   for (int j = 0; j < h; j++)
   {
      int yy = y + j;
      if (yy < 0 || yy >= SH)
         continue;
      int o = orgOff + yy * stride;
      for (int i = 0; i < w; i++)
      {
         int xx = x + i;
         if (xx < 0 || xx >= SW)
            continue;
         uint16_t c = sprPix[src + j * w + i];
         if (c != KEY)
            display[o + xx] = c;
      }
   }
}

