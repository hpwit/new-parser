   drawSkyThings();
   drawBirds();
   drawThings();
}

int menuChoice = 0;
int modeChoice = 0;
// the title menu's row: 0..3 the routes, 4 and 5 the screen
int menuRow = 0;

// the title: flying over the isles by itself; the route and the mode
int title()
{
   if (pixelMode != 2)
      setMode(2);
   loadRoute(0);
   uint32_t t0 = millis();
   // circling round the first route's start, above everything near
   int ax = startX;
   int ay = startY;
   int top = 0;
   for (int a = 0; a < 1024; a = a + 16)
      for (int r = 20; r < 110; r = r + 6)
         top = imax(top, groundAt(ax + ((isin8(a) * r) >> 8), ay + ((icos8(a) * r) >> 8)));
   int alt = imax(top + 40, (SEA << 1) + 120);
   while (true)
   {
      uint32_t now = millis();
      int t = (now - t0) / 33;
      camYaw = (t * 2) & 1023;
      camX = (ax << 16) + isin8(t * 2 - 256) * 60 * 256;
      camY = (ay << 16) + icos8(t * 2 - 256) * 60 * 256;
      camAlt = alt;
      camPitch = 30;
      camBank = 0;
      renderWorld();
      dimRect(70, 16, 260, 50, col(10, 10, 40));
      setInk(col(255, 90, 60), col(40, 10, 10), 4);
      centreText("DRIFTWING", 20);
      setInk(col(255, 240, 220), col(20, 10, 30), 1);
      centreText("courier of the Hundred Isles", 54);
      // the menu: the five routes, free flight, then the two ways to
      // show the game's 400x240 (as Wickwire's): the whole panel, or a
      // window in its middle
      dimRect(92, 92, 216, 122, col(10, 10, 40));
      for (int k = 0; k < 8; k++)
      {
         int y = 96 + k * 13;
         if (k >= 6)
            y = y + 6;
         if (k == menuRow)
         {
            fillRect(98, y - 2, 204, 12, col(255, 160, 60));
            setInk(col(30, 10, 10), col(255, 220, 150), 1);
         }
         else if (k == 6 + modeChoice)
            setInk(col(255, 230, 120), col(10, 10, 30), 1);
         else if (k == 5)
            setInk(col(150, 230, 255), col(10, 10, 30), 1);
         else
            setInk(col(200, 205, 235), col(10, 10, 30), 1);
         if (k < 6)
            centreText(routeName(k), y);
         else if (k == 6)
            centreText("PLAY FULL SCREEN (2x)", y);
         else
            centreText("PLAY IN A WINDOW (1x)", y);
         // the screen chosen: a mark on its left
         if (k == 6 + modeChoice)
            fillRect(106, y + 2, 4, 4, col(255, 230, 120));
      }
      fillRect(104, 172, 192, 1, col(90, 100, 160));
      setInk(col(180, 190, 230), col(10, 10, 30), 1);
      centreText("up/down choose   Enter fly / pick   Esc leave", 212);
      centreText("in the game: M screen  C camera  U/J tilt", 225);
      updateDisplay();
      int k = getKey();
      if (k == KEY_UP || k == KEY_W)
         menuRow = (menuRow + 7) % 8;
      if (k == KEY_DOWN)
         menuRow = (menuRow + 1) % 8;
      if (k == KEY_LEFT || k == KEY_RIGHT || k == KEY_A)
         modeChoice = 1 - modeChoice;
      if (k == KEY_ENTER || k == KEY_SPACE)
      {
         // on a screen: choose it, and back to the routes
         if (menuRow >= 6)
         {
            modeChoice = menuRow - 6;
            menuRow = menuChoice;
         }
         else
         {
            // on a route (or free flight): fly it
            menuChoice = menuRow;
            if (modeChoice == 1)
               setMode(1);
            return 1;
         }
      }
      if (k == KEY_ESC)
         return 0;
   }
   return 1;
}

void story(int off)
{
   int page = off;
   while (page >= 0)
   {
      clearScreen(col(8, 14, 40));
      fillRect(30, 30, SW - 60, 1, col(200, 120, 80));
      fillRect(30, SH - 40, SW - 60, 1, col(200, 120, 80));
      setInk(col(250, 245, 230), col(20, 20, 50), 1);
      int next = drawStoryPage(page, 44, 56, SW - 88, 14);
      setInk(col(170, 180, 220), col(0, 0, 0), 1);
      centreText("Enter", SH - 28);
      updateDisplay();
      if (waitKey() == 0)
         return;
      page = next;
   }
}

