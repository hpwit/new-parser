// Moss Hollow: a little adventure in the four greens of the first handheld
// consoles, on the Guition ESP32-4848S040 (a 4-inch 480x480 touch screen).
//
// The look: a 160x144 screen in four shades of green, 16x16 tiles and
// sprites, an 8x8 font, a text box at the bottom, screens that slide into
// each other. Pixel size 2 makes the panel 240x240; the script draws the
// screen (320x288 on the panel) in a grey case, with a cross, A, B and
// START under it. The sketch reads the touch screen (up to three fingers)
// and sets a bit per button held in touchHeld; the whole left of the pad is
// the cross (the side of its middle the finger is on), A and B are whichever
// is nearer.
//
// The game: a wanderer looks for three crystal shards in nine screens of
// woods, ponds and rocks, and brings them to the shrine in the middle one.
// One shard is behind a locked door; the key is somewhere else. Slimes and
// bats; five hearts; falling sends the wanderer back to the shrine, with
// what was found kept.
//   the cross   walk
//   A           the sword
//   B           the map, while held
//   START       starts a game
// The art and the world are drawn as text in tools/data.py, which writes the
// arrays pasted below.
//
// Needs the modified LovyanGFX Bus_RGB driver (double frame buffer with
// show(), _frame_buffer, pixel_size, offset). Guition4848S040.h is the panel
// configuration.
//
// Board: ESP32S3 Dev Module, PSRAM "OPI PSRAM", Flash Size 16MB.
#include "Guition4848S040.h"
#include "script_executable.h"
#include "binding.h"

LGFX lcd;
uint16_t *frame_buffer;
static uint32_t _sizex = 480;
static uint32_t _sizey = 480;

// once a second: the frames shown, and the time the script takes for one
// (its steps and its drawing, between two show16()), so the frame rate it
// would reach without waiting for the panel
static uint32_t fpsFrames = 0;
static int64_t fpsStart = 0;
static int64_t scriptTime = 0;   // microseconds spent in the script this second
static int64_t leftShow = 0;     // when the last show16() returned

void show16() {
  int64_t in = esp_timer_get_time();
  if (leftShow != 0)
    scriptTime += in - leftShow;
  lcd._bus_instance.show();
  frame_buffer = (uint16_t *)lcd._bus_instance._frame_buffer;
  lcd._panel_instance.resetWriteBuffer();
  fpsFrames++;
  int64_t now = esp_timer_get_time();
  if (now - fpsStart >= 1000000) {
    float perFrame = (float)scriptTime / fpsFrames;
    printf("shown %.1f fps, script %.2f ms a frame (%.0f fps without waiting for the panel)\n",
           fpsFrames * 1000000.0f / (now - fpsStart), perFrame / 1000.0f, 1000000.0f / perFrame);
    fpsFrames = 0;
    scriptTime = 0;
    fpsStart = now;
  }
  leftShow = esp_timer_get_time();
}

void clearscreen() {
  memset(frame_buffer, 0, 480 * 480 * 2);
}

// pixel_size h: each cell is shown as h x h pixels, width x height cells
void setPixelsize(int h) {
  clearscreen();
  show16();
  clearscreen();
  lcd._bus_instance.offset = 0;
  lcd._bus_instance.pixel_size = h;
  _sizex = 480 / h;
  _sizey = 480 / h;
}

uint32_t scriptMillis() {
  return millis();
}

uint32_t scriptRand(uint32_t n) {
  return esp_random() % n;
}

// the backlight, 0 (off) to 255: a script can dim the screen
void scriptSetBrightness(int level) {
  lcd.setBrightness(level < 0 ? 0 : level > 255 ? 255 : level);
}

// --- the buttons, where the script draws them on the 240x240 case ---
// bits of touchHeld: 0 left, 1 right, 2 up, 3 down, 4 A, 5 B, 6 START
#define PAD_TOP 166
#define CROSS_X 56
#define CROSS_Y 204
#define A_X 200
#define A_Y 196
#define B_X 166
#define B_Y 212

static volatile uint32_t touchHeld = 0;

static uint32_t buttonAt(int x, int y) {
  if (y < PAD_TOP)
    return 0;
  // START, between the cross and B
  if (x >= 100 && x < 142 && y >= 214)
    return 1u << 6;
  // the cross: the side of its middle the finger is on
  if (x < 112) {
    int dx = x - CROSS_X, dy = y - CROSS_Y;
    if (abs(dx) < 6 && abs(dy) < 6)
      return 0;
    if (abs(dx) > abs(dy))
      return dx < 0 ? 1u << 0 : 1u << 1;
    return dy < 0 ? 1u << 2 : 1u << 3;
  }
  // A or B, the nearer
  if (x >= 142) {
    int da = (x - A_X) * (x - A_X) + (y - A_Y) * (y - A_Y);
    int db = (x - B_X) * (x - B_X) + (y - B_Y) * (y - B_Y);
    return da < db ? 1u << 4 : 1u << 5;
  }
  return 0;
}

static void touchTask(void *) {
  while (true) {
    lgfx::touch_point_t tp[3];
    int n = lcd.getTouchRaw(tp, 3);
    uint32_t held = 0;
    for (int k = 0; k < n; k++)
      held |= buttonAt(tp[k].x / 2, tp[k].y / 2);
    touchHeld = held;
    vTaskDelay(pdMS_TO_TICKS(16));
  }
}

